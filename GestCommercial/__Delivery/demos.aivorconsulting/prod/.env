# ─── Gestcom Demo — aivorconsulting.com/demos/gestionscommercial ───────────────
# IMPORTANT : ne jamais committer ce fichier dans git
#
# Règles mots de passe SQL Server :
#   INTERDITS  : & ! $ % ^ ` | < > ' " ( ) { } [ ] ; , / \  et non-ASCII
#   AUTORISÉS  : A-Z a-z 0-9 # _ = . ~ -
#   ATTENTION  : + et @ sont problématiques dans les connection strings

# ─── SQL Server ────────────────────────────────────────────────────────────────
SA_PASSWORD=GestComDemo_Sa#2024
DB_SERVER=gestcom-sqlserver
DB_PORT=1433
DB_NAME=GestComDemoDB
DB_USER=gestcom_demo_user
DB_USER_PASSWORD=GestComDemo_Usr#2024

# Port SQL exposé sur localhost du VPS (pour maintenance/backup)
DB_EXPOSE_PORT=15433

# ─── Application Blazor ────────────────────────────────────────────────────────
# Port exposé sur 127.0.0.1 du VPS — nginx d'aivorconsulting.com proxy vers ce port
APP_PORT=5200

# ─── Réinitialisation automatique des données démo ────────────────────────────
# Heure de reset quotidien des données (cron format, heure UTC)
DEMO_RESET_CRON=0 2 * * *

# ─── Identifiants de démonstration (affichés sur la page de connexion) ─────────
DEMO_ADMIN_EMAIL=admin@demo.gestcom
DEMO_ADMIN_PASSWORD=Demo#Admin2024
DEMO_MANAGER_EMAIL=manager@demo.gestcom
DEMO_MANAGER_PASSWORD=Demo#Manager2024
DEMO_EMPLOYEE_EMAIL=employe@demo.gestcom
DEMO_EMPLOYEE_PASSWORD=Demo#Employe2024
