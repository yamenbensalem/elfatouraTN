@page "/commandes-vente"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:commandes-vente.view")]
@inject ICommandeVenteService CommandeService
@inject NavigationManager Nav

<PageTitle>Commandes Vente – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Commandes Vente</h3>
    <a href="commandes-vente/nouveau" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle Commande
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label small mb-1">Client</label>
            <select class="form-select form-select-sm" style="min-width:160px" @bind="_filterClient">
                <option value="">Tous</option>
                @foreach (var c in ClientsDistincts)
                { <option value="@c.CodeClient">@c.NomClient</option> }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">État</label>
            <select class="form-select form-select-sm" style="min-width:140px" @bind="_filterEtat">
                <option value="">Tous</option>
                <option value="Ouvert">Ouvert</option>
                <option value="Confirmé">Confirmé</option>
                <option value="Annulé">Annulé</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Du</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterDebut" />
        </div>
        <div>
            <label class="form-label small mb-1">Au</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterFin" />
        </div>
        <button class="btn btn-sm btn-outline-secondary mb-0" @onclick="ResetFilters">
            <i class="bi bi-x-circle"></i> Réinitialiser
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Commande</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th>Livraison</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in FilteredCommandes)
                    {
                        <tr>
                            <td><a href="commandes-vente/@c.NumeroCommandeVente">@c.NumeroCommandeVente</a></td>
                            <td>@c.DateCommandeVente.ToString("dd/MM/yyyy")</td>
                            <td>@c.Client?.NomClient</td>
                            <td class="text-end">@c.MontantHT.ToString("0.###")</td>
                            <td class="text-end">@c.MontantTVA.ToString("0.###")</td>
                            <td class="text-end fw-bold">@c.MontantTTC.ToString("0.###")</td>
                            <td><span class="badge bg-secondary">@c.EtatCommandeVente</span></td>
                            <td><span class="badge @GetLivraisonBadge(c.EtatLivraison)">@c.EtatLivraison</span></td>
                            <td class="text-end">
                                <PermissionGuard Permission="commandes-vente.update">
                                    <a href="commandes-vente/@c.NumeroCommandeVente" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Modifier
                                    </a>
                                </PermissionGuard>
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => CloneCommande(c.NumeroCommandeVente)">
                                    <i class="bi bi-copy me-1"></i>Cloner
                                </button>
                                <PermissionGuard Permission="commandes-vente.delete">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(c)">
                                        <i class="bi bi-trash me-1"></i>Supprimer
                                    </button>
                                </PermissionGuard>
                            </td>
                        </tr>
                    }
                    @if (!FilteredCommandes.Any())
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">Aucune commande trouvée.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@FilteredCommandes.Count() / @_commandes.Count commande(s)</div>
</div>

<ConfirmDialog Title="Supprimer la commande"
               Message="@($"Confirmer la suppression de la commande {_toDelete?.NumeroCommandeVente} ?")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<CommandeVente> _commandes = [];
    private bool _loading = true;
    private bool _confirmVisible;
    private CommandeVente? _toDelete;
    private Notification _notif = default!;

    private string? _filterClient;
    private string? _filterEtat;
    private DateTime? _filterDebut;
    private DateTime? _filterFin;

    private IEnumerable<CommandeVente> FilteredCommandes => _commandes.Where(c =>
        (string.IsNullOrEmpty(_filterClient) || c.CodeClient == _filterClient) &&
        (string.IsNullOrEmpty(_filterEtat) || c.EtatCommandeVente == _filterEtat) &&
        (!_filterDebut.HasValue || c.DateCommandeVente.Date >= _filterDebut.Value.Date) &&
        (!_filterFin.HasValue || c.DateCommandeVente.Date <= _filterFin.Value.Date));

    private List<Client> ClientsDistincts => _commandes
        .Where(c => c.Client is not null)
        .Select(c => c.Client!)
        .DistinctBy(c => c.CodeClient)
        .OrderBy(c => c.NomClient)
        .ToList();

    private void ResetFilters()
    {
        _filterClient = null;
        _filterEtat = null;
        _filterDebut = null;
        _filterFin = null;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _commandes = await CommandeService.GetAllAsync();
        _loading = false;
    }

    private async Task CloneCommande(string numero)
    {
        try
        {
            var clone = await CommandeService.CloneAsync(numero);
            _notif.ShowSuccess($"Commande clonée : {clone.NumeroCommandeVente}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur lors du clonage : {ex.Message}");
        }
    }

    private void AskDelete(CommandeVente c) { _toDelete = c; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        try
        {
            await CommandeService.DeleteAsync(_toDelete.NumeroCommandeVente);
            _notif.ShowSuccess("Commande supprimée.");
            _toDelete = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }

    private static string GetLivraisonBadge(string etat) => etat switch
    {
        "Livré" => "bg-success",
        "Partiellement Livré" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
