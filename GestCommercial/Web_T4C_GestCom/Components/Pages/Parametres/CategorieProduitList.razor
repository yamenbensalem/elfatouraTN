@page "/parametres/categories"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject IReferenceDataService<CategorieProduit> Service

<PageTitle>Catégories de Produit – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Catégories de Produit</h3>
    <button class="btn btn-primary" @onclick="AskNew">
        <i class="bi bi-plus-circle"></i> Nouvelle Catégorie
    </button>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr><th>Nom</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var c in _items)
                    {
                        <tr>
                            <td>@c.NomCategorieProduit</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => AskEdit(c)">
                                    <i class="bi bi-pencil me-1"></i>Modifier
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(c)">
                                    <i class="bi bi-trash me-1"></i>Supprimer
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!_items.Any())
                    {
                        <tr><td colspan="2" class="text-center text-muted py-4">Aucune catégorie.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@_items.Count catégories</div>
</div>

@if (_editVisible)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="_editing" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(_isNew ? "Nouvelle Catégorie" : "Modifier la Catégorie")</h5>
                        <button type="button" class="btn-close" @onclick="() => _editVisible = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nom <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="_editing!.NomCategorieProduit" />
                            <ValidationMessage For="() => _editing!.NomCategorieProduit" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _editVisible = false">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<ConfirmDialog Title="Supprimer la catégorie"
               Message="@($"Confirmer la suppression de « {_toDelete?.NomCategorieProduit} » ?")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<CategorieProduit> _items = [];
    private bool _loading = true;
    private bool _editVisible;
    private bool _isNew;
    private CategorieProduit? _editing;
    private bool _confirmVisible;
    private CategorieProduit? _toDelete;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await Service.GetAllAsync();
        _loading = false;
    }

    private void AskNew()
    {
        _editing = new CategorieProduit();
        _isNew = true;
        _editVisible = true;
    }

    private void AskEdit(CategorieProduit c)
    {
        _editing = new CategorieProduit { CodeCategorieProduit = c.CodeCategorieProduit, NomCategorieProduit = c.NomCategorieProduit };
        _isNew = false;
        _editVisible = true;
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_isNew) await Service.AddAsync(_editing!);
            else await Service.UpdateAsync(_editing!);
            _editVisible = false;
            _notif.ShowSuccess("Enregistré.");
            await LoadAsync();
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private void AskDelete(CategorieProduit c) { _toDelete = c; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        try
        {
            await Service.DeleteAsync(_toDelete);
            _notif.ShowSuccess("Supprimé.");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError(DeleteErrorMessageHelper.Build(ex, "Impossible de supprimer : cette catégorie est utilisée par au moins un produit."));
        }
    }
}
