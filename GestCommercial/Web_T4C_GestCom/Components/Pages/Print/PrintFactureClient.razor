@page "/print/facture-client/{Numero}"
@layout PrintLayout
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:factures.view")]
@inject AppDbContext Db
@inject AppConfigService Config
@inject IJSRuntime JS

<PageTitle>@(_facture?.IsAvoir == true ? "Avoir" : "Facture") @Numero – Impression</PageTitle>

@if (_loading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height:50vh">
        <div class="spinner-border text-primary me-3"></div>
        <span>Chargement du document…</span>
    </div>
}
else if (_facture is null)
{
    <div class="alert alert-danger m-4">Document introuvable : @Numero</div>
}
else
{
    <div class="print-toolbar">
        <button class="btn btn-primary btn-sm" @onclick="@(() => JS.InvokeVoidAsync("window.print"))">
            <i class="bi bi-printer me-1"></i>Imprimer / PDF
        </button>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.close()">
            <i class="bi bi-x me-1"></i>Fermer
        </button>
        <span class="ms-auto text-muted small">
            @(_facture.IsAvoir ? "AVOIR" : "FACTURE CLIENT") · @_facture.NumeroFactureClient
        </span>
    </div>

    <div class="print-wrapper">
        <div class="print-document">

            <PrintDocHeader Entreprise="_entreprise"
                            DocType="@(_facture.IsAvoir ? "AVOIR" : "FACTURE CLIENT")"
                            Numero="@_facture.NumeroFactureClient"
                            Date="_facture.DateFactureClient"
                            Etat="@_facture.EtatFacture" />

            <!-- Client -->
            <div class="print-parties">
                <div>
                    <div class="print-party-label">Facturé à</div>
                    <div class="print-party-name">@_facture.Client?.NomClient</div>
                    @if (!string.IsNullOrWhiteSpace(_facture.Client?.MatriculeFiscale))
                    { <div>MF : @_facture.Client.MatriculeFiscale</div> }
                    @if (!string.IsNullOrWhiteSpace(_facture.Client?.Adresse))
                    { <div>@_facture.Client.Adresse</div> }
                    @if (!string.IsNullOrWhiteSpace(_facture.Client?.Ville))
                    { <div>@_facture.Client.CodePostal @_facture.Client.Ville</div> }
                    @if (!string.IsNullOrWhiteSpace(_facture.Client?.Tel))
                    { <div>Tél : @_facture.Client.Tel</div> }
                </div>
                <div class="text-end">
                    <div class="print-party-label">État règlement</div>
                    <div class="print-party-name">@_facture.EtatReglement</div>
                    @if (_facture.Reglements?.Any() == true)
                    {
                        <div class="mt-1 small">
                            Réglé : @_facture.Reglements.Sum(r => r.Montant).ToString("0.###") TND
                        </div>
                    }
                </div>
            </div>

            <!-- Lines -->
            <table class="print-table">
                <thead>
                    <tr>
                        <th style="width:38%">Désignation</th>
                        <th class="text-center" style="width:8%">Qté</th>
                        <th class="text-end" style="width:13%">Prix HT</th>
                        <th class="text-center" style="width:8%">Rem%</th>
                        <th class="text-center" style="width:7%">TVA%</th>
                        <th class="text-end" style="width:13%">Montant HT</th>
                        <th class="text-end" style="width:13%">Montant TTC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in _facture.Lignes)
                    {
                        var ttc = Math.Round(l.MontantHT * (1 + l.Tva / 100), 3);
                        <tr>
                            <td>@(l.Produit?.DesignationProduit ?? l.CodeProduit)</td>
                            <td class="text-center">@l.Quantite.ToString("0.###")</td>
                            <td class="text-end">@l.PrixUnitaire.ToString("0.###")</td>
                            <td class="text-center">@(l.Remise > 0 ? l.Remise.ToString("0.##") + "%" : "—")</td>
                            <td class="text-center">@l.Tva.ToString("0.##")%</td>
                            <td class="text-end">@l.MontantHT.ToString("0.###")</td>
                            <td class="text-end">@ttc.ToString("0.###")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Totals -->
            <div class="print-totals-wrap">
                <table class="print-totals-table">
                    <tr><td>Total HT</td><td class="text-end">@_facture.MontantHT.ToString("0.###")</td></tr>
                    @if (_facture.Remise > 0)
                    {
                        <tr>
                            <td>Remise (@_facture.Remise%)</td>
                            <td class="text-end text-danger">-@(_facture.MontantHT * _facture.Remise / 100).ToString("0.###")</td>
                        </tr>
                    }
                    @if (_facture.Fodec > 0)
                    {
                        <tr><td>FODEC</td><td class="text-end">@_facture.Fodec.ToString("0.###")</td></tr>
                    }
                    <tr><td>TVA</td><td class="text-end">@_facture.MontantTVA.ToString("0.###")</td></tr>
                    <tr><td>Total TTC</td><td class="text-end fw-semibold">@_facture.MontantTTC.ToString("0.###")</td></tr>
                    <tr><td>Timbre Fiscal</td><td class="text-end">@_facture.Timbre.ToString("0.###")</td></tr>
                    <tr class="print-totals-net">
                        <td>Net à Payer</td>
                        <td class="text-end">@((_facture.MontantTTC + _facture.Timbre).ToString("0.###")) TND</td>
                    </tr>
                </table>
            </div>

            <!-- Note -->
            @if (!string.IsNullOrWhiteSpace(_facture.Note))
            {
                <div class="print-note"><strong>Note :</strong> @_facture.Note</div>
            }

            <!-- Règlements (printed only if any) -->
            @if (_facture.Reglements?.Any() == true)
            {
                <div class="mt-3">
                    <div class="fw-semibold mb-1" style="font-size:0.85rem">Règlements</div>
                    <table class="print-table" style="font-size:0.8rem">
                        <thead>
                            <tr>
                                <th>Date</th><th>Mode</th><th>Référence</th><th class="text-end">Montant</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _facture.Reglements)
                            {
                                <tr>
                                    <td>@r.DateReglement.ToString("dd/MM/yyyy")</td>
                                    <td>@r.ModePayement?.NomModePayement</td>
                                    <td>@r.Reference</td>
                                    <td class="text-end">@r.Montant.ToString("0.###")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="print-footer">
                @if (_entreprise is not null)
                {
                    <span>@_entreprise.NomEntreprise</span>
                    @if (!string.IsNullOrWhiteSpace(_entreprise.Rib)) { <span> · RIB : @_entreprise.Rib</span> }
                    <br />
                }
                <small>Imprimé le @DateTime.Now.ToString("dd/MM/yyyy à HH:mm", new System.Globalization.CultureInfo("fr-FR"))</small>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Numero { get; set; } = string.Empty;
    private FactureClient? _facture;
    private Entreprise? _entreprise;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _facture = await Db.FacturesClient
            .Include(f => f.Client)
            .Include(f => f.Lignes).ThenInclude(l => l.Produit)
            .Include(f => f.Reglements).ThenInclude(r => r.ModePayement)
            .FirstOrDefaultAsync(f => f.NumeroFactureClient == Numero);
        _entreprise = await Db.Entreprises.FirstOrDefaultAsync();
        _loading = false;
    }
}
