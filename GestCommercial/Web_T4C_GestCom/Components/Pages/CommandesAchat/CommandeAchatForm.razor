@page "/commandes-achat/nouveau"
@page "/commandes-achat/{Numero}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:commandes-achat.view")]
@inject ICommandeAchatService CommandeService
@inject IFournisseurService FournisseurService
@inject IProduitService ProduitService
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nouvelle Commande Achat" : $"Commande {Numero}") – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isNew ? "Nouvelle Commande Achat" : $"Commande {Numero}")</h3>
    <div class="d-flex gap-2">
        @if (!_isNew)
        {
            <a href="/print/commande-achat/@Numero" target="_blank" class="btn btn-outline-success">
                <i class="bi bi-printer me-1"></i>Imprimer
            </a>
            <button class="btn btn-outline-info" @onclick="Clone">
                <i class="bi bi-copy"></i> Cloner
            </button>
        }
        <a href="/commandes-achat" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<Notification @ref="_notif" />
<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <EditForm Model="_commande" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">En-tête</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Date <span class="text-danger">*</span></label>
                        <InputDate class="form-control" @bind-Value="_commande.DateCommandeAchat" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fournisseur <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_commande.CodeFournisseur">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var f in _fournisseurs)
                            {
                                <option value="@f.CodeFournisseur">@f.NomFournisseur</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _commande.CodeFournisseur" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">État</label>
                        <InputSelect class="form-select" @bind-Value="_commande.EtatCommandeAchat">
                            <option>Ouvert</option>
                            <option>Confirmé</option>
                            <option>Annulé</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">État Réception</label>
                        <InputSelect class="form-select" @bind-Value="_commande.EtatReception">
                            <option>Non Reçu</option>
                            <option>Partiellement Reçu</option>
                            <option>Reçu</option>
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Note</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_commande.Note" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Lignes</span>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLigne">
                    <i class="bi bi-plus"></i> Ajouter une ligne
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:38%">Produit</th>
                            <th style="width:10%">Quantité</th>
                            <th style="width:13%">Prix Achat HT</th>
                            <th style="width:10%">TVA %</th>
                            <th style="width:12%" class="text-end">Montant HT</th>
                            <th style="width:5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _lignes.Count; i++)
                        {
                            var idx = i;
                            <tr>
                                <td>
                                    <select class="form-select form-select-sm"
                                            value="@_lignes[idx].CodeProduit"
                                            @onchange="e => OnProduitChanged(e, idx)">
                                        <option value="">-- Produit --</option>
                                        @foreach (var p in _produits)
                                        {
                                            <option value="@p.CodeProduit">@p.DesignationProduit</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].Quantite"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].PrixUnitaire"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].Tva"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td class="text-end align-middle fw-semibold">
                                    @_lignes[idx].MontantHT.ToString("0.###")
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveLigne(idx)">
                                        <i class="bi bi-trash me-1"></i>Retirer
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!_lignes.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">Aucune ligne. Cliquez sur « Ajouter une ligne ».</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-4">
                        <table class="table table-sm mb-0">
                            <tr>
                                <td>Total HT</td>
                                <td class="text-end">@_commande.MontantHT.ToString("0.###")</td>
                            </tr>
                            <tr>
                                <td>TVA</td>
                                <td class="text-end">@_commande.MontantTVA.ToString("0.###")</td>
                            </tr>
                            <tr class="fw-bold table-light">
                                <td>Total TTC</td>
                                <td class="text-end">@_commande.MontantTTC.ToString("0.###")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Enregistrer
            </button>
            <a href="/commandes-achat" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string? Numero { get; set; }

    private CommandeAchat _commande = new() { DateCommandeAchat = DateTime.Today, EtatCommandeAchat = "Ouvert", EtatReception = "Non Reçu" };
    private List<LigneCommandeAchat> _lignes = [];
    private List<Fournisseur> _fournisseurs = [];
    private List<Produit> _produits = [];
    private bool _loading = true;
    private bool _isNew => Numero is null;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _fournisseurs = await FournisseurService.GetAllAsync();
        _produits = await ProduitService.GetAllAsync();

        if (!_isNew)
        {
            var existing = await CommandeService.GetByNumeroAsync(Numero!);
            if (existing is null) { Nav.NavigateTo("/commandes-achat"); return; }
            _commande = existing;
            _lignes = existing.Lignes?.ToList() ?? [];
        }
        _loading = false;
    }

    private void OnProduitChanged(ChangeEventArgs e, int idx)
    {
        var code = e.Value?.ToString();
        _lignes[idx].CodeProduit = code ?? string.Empty;
        var produit = _produits.FirstOrDefault(p => p.CodeProduit == code);
        if (produit != null)
        {
            _lignes[idx].PrixUnitaire = produit.PrixAchatTTC > 0 ? produit.PrixAchatTTC : produit.PrixVenteHT;
            _lignes[idx].Tva = produit.TvaProduit?.TauxTvaProduit ?? 19;
        }
        RecalculerLigne(idx);
    }

    private void RecalculerLigne(int idx)
    {
        var l = _lignes[idx];
        l.MontantHT = Math.Round(l.Quantite * l.PrixUnitaire, 3);
        RecalculerTotaux();
    }

    private void RecalculerTotaux()
    {
        _commande.MontantHT = _lignes.Sum(l => l.MontantHT);
        _commande.MontantTVA = Math.Round(_lignes.Sum(l => l.MontantHT * l.Tva / 100.0), 3);
        _commande.MontantTTC = Math.Round(_commande.MontantHT + _commande.MontantTVA, 3);
    }

    private void AddLigne() => _lignes.Add(new LigneCommandeAchat { Tva = 19 });
    private void RemoveLigne(int idx) { _lignes.RemoveAt(idx); RecalculerTotaux(); }

    private async Task Save()
    {
        try
        {
            if (_isNew)
                await CommandeService.CreateAsync(_commande, _lignes);
            else
                await CommandeService.UpdateAsync(_commande, _lignes);
            Nav.NavigateTo("/commandes-achat");
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private async Task Clone()
    {
        try
        {
            var clone = await CommandeService.CloneAsync(Numero!);
            Nav.NavigateTo($"/commandes-achat/{clone.NumeroCommandeAchat}");
        }
        catch (Exception ex) { _notif.ShowError($"Erreur lors du clonage : {ex.Message}"); }
    }
}
