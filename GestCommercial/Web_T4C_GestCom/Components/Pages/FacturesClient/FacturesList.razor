@page "/factures-client"
@page "/avoirs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:factures.view")]
@inject IFactureClientService FactureService
@inject NavigationManager Nav

<PageTitle>@(_isAvoir ? "Avoirs" : "Factures Client") – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isAvoir ? "Avoirs" : "Factures Client")</h3>
    <a href="@(_isAvoir ? "avoirs/nouveau" : "factures-client/nouveau")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> @(_isAvoir ? "Nouvel Avoir" : "Nouvelle Facture")
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Facture</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Timbre</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th>Règlement</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _factures)
                    {
                        <tr>
                            <td><a href="@(_isAvoir ? "avoirs" : "factures-client")/@f.NumeroFactureClient">@f.NumeroFactureClient</a></td>
                            <td>@f.DateFactureClient.ToString("dd/MM/yyyy")</td>
                            <td>@f.Client?.NomClient</td>
                            <td class="text-end">@f.MontantHT.ToString("0.###")</td>
                            <td class="text-end">@f.MontantTVA.ToString("0.###")</td>
                            <td class="text-end">@f.Timbre.ToString("0.###")</td>
                            <td class="text-end fw-bold">@((f.MontantTTC + f.Timbre).ToString("0.###"))</td>
                            <td><span class="badge bg-secondary">@f.EtatFacture</span></td>
                            <td>
                                <span class="badge @GetReglementBadge(f.EtatReglement)">@f.EtatReglement</span>
                            </td>
                            <td class="text-end">
                                <a href="@(_isAvoir ? "avoirs" : "factures-client")/@f.NumeroFactureClient"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil me-1"></i>Modifier
                                </a>
                                <button class="btn btn-sm btn-outline-info me-1"
                                        @onclick="() => CloneFacture(f.NumeroFactureClient)">
                                    <i class="bi bi-copy me-1"></i>Cloner
                                </button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(f)">
                                    <i class="bi bi-trash me-1"></i>Supprimer
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!_factures.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">Aucune facture trouvée.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@_factures.Count facture(s)</div>
</div>

<ConfirmDialog Title="Supprimer la facture"
               Message="@($"Confirmer la suppression de la facture {_toDelete?.NumeroFactureClient} ?")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<FactureClient> _factures = [];
    private bool _loading = true;
    private bool _isAvoir;
    private bool _confirmVisible;
    private FactureClient? _toDelete;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _isAvoir = Nav.Uri.Contains("/avoirs");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _factures = await FactureService.GetAllAsync(_isAvoir);
        _loading = false;
    }

    private async Task CloneFacture(string numero)
    {
        try
        {
            var clone = await FactureService.CloneAsync(numero, _isAvoir);
            _notif.ShowSuccess($"Document cloné : {clone.NumeroFactureClient}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur lors du clonage : {ex.Message}");
        }
    }

    private void AskDelete(FactureClient f) { _toDelete = f; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        await FactureService.DeleteAsync(_toDelete.NumeroFactureClient);
        _notif.ShowSuccess("Facture supprimée.");
        _toDelete = null;
        await LoadAsync();
    }

    private static string GetReglementBadge(string etat) => etat switch
    {
        "Réglé" => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
