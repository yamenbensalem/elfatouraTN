@page "/factures-client"
@page "/avoirs"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:factures.view")]
@inject IFactureClientService FactureService
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(_isAvoir ? "Avoirs" : "Factures Client") – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isAvoir ? "Avoirs" : "Factures Client")</h3>
    <a href="@(_isAvoir ? "avoirs/nouveau" : "factures-client/nouveau")" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> @(_isAvoir ? "Nouvel Avoir" : "Nouvelle Facture")
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label small mb-1">Client</label>
            <select class="form-select form-select-sm" style="min-width:160px" @bind="_filterClient">
                <option value="">Tous</option>
                @foreach (var c in ClientsDistincts)
                { <option value="@c.CodeClient">@c.NomClient</option> }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">État</label>
            <select class="form-select form-select-sm" style="min-width:150px" @bind="_filterEtat">
                <option value="">Tous</option>
                <option value="Facture Ouverte">Facture Ouverte</option>
                <option value="Facture Livrée">Facture Livrée</option>
                <option value="Facture Clôturée">Facture Clôturée</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Du</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterDebut" />
        </div>
        <div>
            <label class="form-label small mb-1">Au</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterFin" />
        </div>
        <button class="btn btn-sm btn-outline-secondary mb-0" @onclick="ResetFilters">
            <i class="bi bi-x-circle"></i> Réinitialiser
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Facture</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Timbre</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th>Règlement</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="FilteredFactures" Context="f">
                        <ItemContent>
                            <tr>
                                <td><a href="@(_isAvoir ? "avoirs" : "factures-client")/@f.NumeroFactureClient">@f.NumeroFactureClient</a></td>
                                <td>@f.DateFactureClient.ToString("dd/MM/yyyy")</td>
                                <td>@f.Client?.NomClient</td>
                                <td class="text-end">@f.MontantHT.ToString("0.###")</td>
                                <td class="text-end">@f.MontantTVA.ToString("0.###")</td>
                                <td class="text-end">@f.Timbre.ToString("0.###")</td>
                                <td class="text-end fw-bold">@((f.MontantTTC + f.Timbre).ToString("0.###"))</td>
                                <td><span class="badge bg-secondary">@f.EtatFacture</span></td>
                                <td>
                                    <span class="badge @GetReglementBadge(f.EtatReglement)">@f.EtatReglement</span>
                                </td>
                                <td class="text-end">
                                    <PermissionGuard Permission="factures.update">
                                        <a href="@(_isAvoir ? "avoirs" : "factures-client")/@f.NumeroFactureClient"
                                           class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil me-1"></i>Modifier
                                        </a>
                                    </PermissionGuard>
                                    <button class="btn btn-sm btn-outline-info me-1"
                                            @onclick="() => CloneFacture(f.NumeroFactureClient)">
                                        <i class="bi bi-copy me-1"></i>Cloner
                                    </button>
                                    <PermissionGuard Permission="factures.delete">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(f)">
                                            <i class="bi bi-trash me-1"></i>Supprimer
                                        </button>
                                    </PermissionGuard>
                                </td>
                            </tr>
                        </ItemContent>
                        <EmptyContent>
                            <tr><td colspan="10" class="text-center text-muted py-4">Aucune facture trouvée.</td></tr>
                        </EmptyContent>
                    </Virtualize>
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@FilteredFactures.Count / @_factures.Count facture(s)</div>
</div>

<ConfirmDialog Title="Supprimer la facture"
               Message="@($"Confirmer la suppression de la facture {_toDelete?.NumeroFactureClient} ?")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<FactureClient> _factures = [];
    private bool _loading = true;
    private bool _isAvoir;
    private string _loadedPath = string.Empty;
    private bool _confirmVisible;
    private FactureClient? _toDelete;
    private Notification _notif = default!;

    private string? _filterClient;
    private string? _filterEtat;
    private DateTime? _filterDebut;
    private DateTime? _filterFin;

    private List<FactureClient> FilteredFactures => _factures.Where(f =>
        (string.IsNullOrEmpty(_filterClient) || f.CodeClient == _filterClient) &&
        (string.IsNullOrEmpty(_filterEtat) || f.EtatFacture == _filterEtat) &&
        (!_filterDebut.HasValue || f.DateFactureClient.Date >= _filterDebut.Value.Date) &&
        (!_filterFin.HasValue || f.DateFactureClient.Date <= _filterFin.Value.Date))
        .ToList();

    private List<Client> ClientsDistincts => _factures
        .Where(f => f.Client is not null)
        .Select(f => f.Client!)
        .DistinctBy(c => c.CodeClient)
        .OrderBy(c => c.NomClient)
        .ToList();

    private void ResetFilters()
    {
        _filterClient = null;
        _filterEtat = null;
        _filterDebut = null;
        _filterFin = null;
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await RefreshForUriAsync(Nav.Uri, force: true);
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _factures = await FactureService.GetAllAsync(_isAvoir);
        _loading = false;
    }

    private async Task RefreshForUriAsync(string uri, bool force = false)
    {
        var path = NormalizePath(uri);
        if (!force && string.Equals(_loadedPath, path, StringComparison.OrdinalIgnoreCase))
            return;

        _loadedPath = path;
        _isAvoir = path.StartsWith("avoirs", StringComparison.OrdinalIgnoreCase);
        ResetFilters();
        await LoadAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = NormalizePath(e.Location);
        var isFactureRoute = path.StartsWith("factures-client", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("avoirs", StringComparison.OrdinalIgnoreCase);

        if (!isFactureRoute)
        {
            // Force a fresh fetch if the user comes back from another module.
            _loadedPath = string.Empty;
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshForUriAsync(e.Location);
            StateHasChanged();
        });
    }

    private static string NormalizePath(string uri)
    {
        var relative = new Uri(uri).GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
        var qIndex = relative.IndexOf('?', StringComparison.Ordinal);
        if (qIndex >= 0)
            relative = relative[..qIndex];

        return relative.Trim('/');
    }

    private async Task CloneFacture(string numero)
    {
        try
        {
            var clone = await FactureService.CloneAsync(numero, _isAvoir);
            _notif.ShowSuccess($"Document cloné : {clone.NumeroFactureClient}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur lors du clonage : {ex.Message}");
        }
    }

    private void AskDelete(FactureClient f) { _toDelete = f; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        try
        {
            await FactureService.DeleteAsync(_toDelete.NumeroFactureClient);
            _notif.ShowSuccess("Facture supprimée.");
            _toDelete = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }

    private static string GetReglementBadge(string etat) => etat switch
    {
        "Réglé" => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _ => "bg-danger"
    };

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
