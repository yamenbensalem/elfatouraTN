@page "/entreprise"
@rendermode InteractiveServer
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>Fiche Entreprise – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Fiche Entreprise</h3>
</div>

<Notification @ref="_notif" />
<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <EditForm Model="_entreprise" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Informations Générales</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_entreprise.NomEntreprise" />
                        <ValidationMessage For="() => _entreprise.NomEntreprise" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Matricule Fiscale</label>
                        <InputText class="form-control" @bind-Value="_entreprise.MatriculeFiscale" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Coordonnées</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Adresse</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Adresse" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Code Postal</label>
                        <InputText class="form-control" @bind-Value="_entreprise.CodePostal" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ville</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Ville" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Pays</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Pays" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Téléphone</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Tel" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fax</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Fax" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Email" type="email" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Site Web</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Site" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Informations Bancaires & Autres</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">RIB</label>
                        <InputText class="form-control" @bind-Value="_entreprise.Rib" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Chemin du Logo</label>
                        <InputText class="form-control" @bind-Value="_entreprise.PathLogo"
                                   placeholder="./logoApp.png" />
                        <div class="form-text">Exemples: <code>logoApp.png</code>, <code>images/mon-logo.png</code>, <code>https://...</code></div>
                        <div class="mt-2">
                            <img src="@GetLogoPreviewPath()"
                                 alt="Aperçu du logo"
                                 style="max-height:60px;max-width:240px;object-fit:contain;border:1px solid #e5e7eb;border-radius:0.375rem;padding:0.35rem;background:#fff;"
                                 onerror="this.style.display='none';" />
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Note</label>
                        <InputTextArea class="form-control" @bind-Value="_entreprise.Note" rows="2" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Enregistrer
            </button>
        </div>
    </EditForm>
}

@code {
    private Entreprise _entreprise = new();
    private bool _loading = true;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        var existing = await Db.Entreprises.FirstOrDefaultAsync();
        if (existing is not null)
            _entreprise = existing;
        else
            _entreprise = new Entreprise { CodeEntreprise = "ENT001", NomEntreprise = string.Empty };
        _loading = false;
    }

    private async Task SaveAsync()
    {
        try
        {
            var exists = await Db.Entreprises.AnyAsync(e => e.CodeEntreprise == _entreprise.CodeEntreprise);
            if (exists)
                Db.Entreprises.Update(_entreprise);
            else
                Db.Entreprises.Add(_entreprise);
            await Db.SaveChangesAsync();
            _notif.ShowSuccess("Fiche entreprise enregistrée.");
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }

    private string GetLogoPreviewPath()
    {
        var raw = _entreprise.PathLogo;

        if (string.IsNullOrWhiteSpace(raw))
            return "logoApp.png";

        var path = raw.Trim();

        if (path.StartsWith("~/", StringComparison.Ordinal))
            path = path[2..];
        if (path.StartsWith("./", StringComparison.Ordinal))
            path = path[2..];

        return path;
    }
}
