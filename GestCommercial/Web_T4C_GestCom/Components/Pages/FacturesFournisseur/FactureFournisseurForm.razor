@page "/factures-fournisseur/nouveau"
@page "/factures-fournisseur/{Numero}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:factures-fournisseur.view")]
@inject IFactureFournisseurService FactureService
@inject IFournisseurService FournisseurService
@inject IProduitService ProduitService
@inject AppConfigService Config
@inject NavigationManager Nav
@inject AppDbContext Db

<PageTitle>@(_isNew ? "Nouvelle Facture Fournisseur" : $"Facture {Numero}") – T4C GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isNew ? "Nouvelle Facture Fournisseur" : $"Facture Fournisseur {Numero}")</h3>
    <div class="d-flex gap-2">
        @if (!_isNew)
        {
            <a href="/print/facture-fournisseur/@Numero" target="_blank" class="btn btn-outline-success">
                <i class="bi bi-printer me-1"></i>Imprimer
            </a>
            <button class="btn btn-outline-info" @onclick="Clone">
                <i class="bi bi-copy"></i> Cloner
            </button>
        }
        <a href="/factures-fournisseur" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>

<Notification @ref="_notif" />
<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <EditForm Model="_facture" OnValidSubmit="Save">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">En-tête</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Date <span class="text-danger">*</span></label>
                        <InputDate class="form-control" @bind-Value="_facture.DateFactureFournisseur" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fournisseur <span class="text-danger">*</span></label>
                        <InputSelect class="form-select" @bind-Value="_facture.CodeFournisseur">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var f in _fournisseurs)
                            {
                                <option value="@f.CodeFournisseur">@f.NomFournisseur</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _facture.CodeFournisseur" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">État Facture</label>
                        <InputSelect class="form-select" @bind-Value="_facture.EtatFacture">
                            <option>Facture Ouverte</option>
                            <option>Facture Validée</option>
                            <option>Facture Annulée</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Timbre Fiscal</label>
                        <div class="form-control bg-light">@_facture.Timbre.ToString("0.###") TND</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Note</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="_facture.Note" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                <span>Lignes</span>
                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddLigne">
                    <i class="bi bi-plus"></i> Ajouter une ligne
                </button>
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:38%">Produit</th>
                            <th style="width:10%">Quantité</th>
                            <th style="width:13%">Prix Achat HT</th>
                            <th style="width:10%">TVA %</th>
                            <th style="width:12%" class="text-end">Montant HT</th>
                            <th style="width:5%"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < _lignes.Count; i++)
                        {
                            var idx = i;
                            <tr>
                                <td>
                                    <select class="form-select form-select-sm"
                                            value="@_lignes[idx].CodeProduit"
                                            @onchange="e => OnProduitChanged(e, idx)">
                                        <option value="">-- Produit --</option>
                                        @foreach (var p in _produits)
                                        {
                                            <option value="@p.CodeProduit">@p.DesignationProduit</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].Quantite"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].PrixUnitaire"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td>
                                    <InputNumber class="form-control form-control-sm"
                                                 @bind-Value="_lignes[idx].Tva"
                                                 @bind-Value:after="() => RecalculerLigne(idx)" />
                                </td>
                                <td class="text-end align-middle fw-semibold">
                                    @_lignes[idx].MontantHT.ToString("0.###")
                                </td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-danger"
                                            @onclick="() => RemoveLigne(idx)">
                                        <i class="bi bi-trash me-1"></i>Retirer
                                    </button>
                                </td>
                            </tr>
                        }
                        @if (!_lignes.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">Aucune ligne. Cliquez sur « Ajouter une ligne ».</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row justify-content-end">
                    <div class="col-md-4">
                        <table class="table table-sm mb-0">
                            <tr>
                                <td>Total HT</td>
                                <td class="text-end">@_facture.MontantHT.ToString("0.###")</td>
                            </tr>
                            <tr>
                                <td>TVA</td>
                                <td class="text-end">@_facture.MontantTVA.ToString("0.###")</td>
                            </tr>
                            <tr>
                                <td>Total TTC</td>
                                <td class="text-end">@_facture.MontantTTC.ToString("0.###")</td>
                            </tr>
                            <tr>
                                <td>Timbre Fiscal</td>
                                <td class="text-end">@_facture.Timbre.ToString("0.###")</td>
                            </tr>
                            <tr class="fw-bold table-light fs-6">
                                <td>Net à Payer</td>
                                <td class="text-end">@((_facture.MontantTTC + _facture.Timbre).ToString("0.###"))</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mb-4">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle"></i> Enregistrer
            </button>
            <a href="/factures-fournisseur" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </EditForm>

    @if (!_isNew)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">
                Règlements
                <span class="badge @GetReglementBadge(_facture.EtatReglement) ms-2">@_facture.EtatReglement</span>
            </div>
            <div class="card-body">
                @if (_reglements.Any())
                {
                    <table class="table table-sm mb-3">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Mode</th>
                                <th class="text-end">Montant</th>
                                <th>Référence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in _reglements)
                            {
                                <tr>
                                    <td>@r.DateReglement.ToString("dd/MM/yyyy")</td>
                                    <td>@r.ModePayement?.NomModePayement</td>
                                    <td class="text-end">@r.Montant.ToString("0.###")</td>
                                    <td>@r.Reference</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="mb-3">
                        Solde restant :
                        <strong class="@(_solde <= 0 ? "text-success" : "text-danger")">
                            @_solde.ToString("0.###") TND
                        </strong>
                    </p>
                }
                else
                {
                    <p class="text-muted mb-3">Aucun règlement enregistré.</p>
                }

                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label small">Date</label>
                        <InputDate class="form-control form-control-sm" @bind-Value="_newReglement.DateReglement" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Mode de paiement</label>
                        <InputSelect class="form-select form-select-sm" @bind-Value="_newReglement.CodeModePayement">
                            @foreach (var m in _modes)
                            {
                                <option value="@m.CodeModePayement">@m.NomModePayement</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Montant</label>
                        <InputNumber class="form-control form-control-sm" @bind-Value="_newReglement.Montant" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small">Référence</label>
                        <InputText class="form-control form-control-sm" @bind-Value="_newReglement.Reference"
                                   placeholder="N° chèque, virement..." />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-sm btn-primary w-100" @onclick="AddReglement">
                            <i class="bi bi-plus-circle"></i> Ajouter
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string? Numero { get; set; }

    private FactureFournisseur _facture = new() { DateFactureFournisseur = DateTime.Today, EtatFacture = "Facture Ouverte", EtatReglement = "Non Réglé" };
    private List<LigneFactureFournisseur> _lignes = [];
    private List<ReglementFactureFournisseur> _reglements = [];
    private ReglementFactureFournisseur _newReglement = new() { DateReglement = DateTime.Today, CodeModePayement = 1 };
    private List<Fournisseur> _fournisseurs = [];
    private List<Produit> _produits = [];
    private List<ModePayement> _modes = [];
    private double _solde;
    private bool _loading = true;
    private bool _isNew => Numero is null;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _fournisseurs = await FournisseurService.GetAllAsync();
        _produits = await ProduitService.GetAllAsync();
        _modes = await Db.ModesPayement.ToListAsync();
        _facture.Timbre = Config.TimbreFiscal;

        if (!_isNew)
        {
            var existing = await FactureService.GetByNumeroAsync(Numero!);
            if (existing is null) { Nav.NavigateTo("/factures-fournisseur"); return; }
            _facture = existing;
            _lignes = existing.Lignes?.ToList() ?? [];
            _reglements = existing.Reglements?.ToList() ?? [];
            _solde = await FactureService.GetSoldeAsync(Numero!);
        }
        _loading = false;
    }

    private void OnProduitChanged(ChangeEventArgs e, int idx)
    {
        var code = e.Value?.ToString();
        _lignes[idx].CodeProduit = code ?? string.Empty;
        var produit = _produits.FirstOrDefault(p => p.CodeProduit == code);
        if (produit != null)
        {
            _lignes[idx].PrixUnitaire = produit.PrixAchatTTC > 0 ? produit.PrixAchatTTC : produit.PrixVenteHT;
            _lignes[idx].Tva = produit.TvaProduit?.TauxTvaProduit ?? 19;
        }
        RecalculerLigne(idx);
    }

    private void RecalculerLigne(int idx)
    {
        var l = _lignes[idx];
        l.MontantHT = Math.Round(l.Quantite * l.PrixUnitaire, 3);
        RecalculerTotaux();
    }

    private void RecalculerTotaux()
    {
        _facture.MontantHT = _lignes.Sum(l => l.MontantHT);
        _facture.MontantTVA = Math.Round(_lignes.Sum(l => l.MontantHT * l.Tva / 100.0), 3);
        _facture.MontantTTC = Math.Round(_facture.MontantHT + _facture.MontantTVA, 3);
    }

    private void AddLigne() => _lignes.Add(new LigneFactureFournisseur { Tva = 19 });
    private void RemoveLigne(int idx) { _lignes.RemoveAt(idx); RecalculerTotaux(); }

    private async Task Save()
    {
        try
        {
            if (_isNew)
                await FactureService.CreateAsync(_facture, _lignes);
            else
                await FactureService.UpdateAsync(_facture, _lignes);
            Nav.NavigateTo("/factures-fournisseur");
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private async Task AddReglement()
    {
        if (_newReglement.Montant <= 0) { _notif.ShowError("Montant invalide."); return; }
        try
        {
            _newReglement.NumeroFactureFournisseur = Numero!;
            await FactureService.AddReglementAsync(_newReglement);
            var updated = await FactureService.GetByNumeroAsync(Numero!);
            if (updated is not null)
            {
                _facture.EtatReglement = updated.EtatReglement;
                _reglements = updated.Reglements?.ToList() ?? [];
            }
            _solde = await FactureService.GetSoldeAsync(Numero!);
            _newReglement = new() { DateReglement = DateTime.Today, CodeModePayement = 1, NumeroFactureFournisseur = Numero! };
            _notif.ShowSuccess("Règlement ajouté.");
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private async Task Clone()
    {
        try
        {
            var clone = await FactureService.CloneAsync(Numero!);
            Nav.NavigateTo($"/factures-fournisseur/{clone.NumeroFactureFournisseur}");
        }
        catch (Exception ex) { _notif.ShowError($"Erreur lors du clonage : {ex.Message}"); }
    }

    private static string GetReglementBadge(string etat) => etat switch
    {
        "Réglé" => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
