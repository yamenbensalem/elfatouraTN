@inherits LayoutComponentBase
@implements IDisposable
@inject ICurrentUserService CurrentUserService
@inject AuthenticationStateProvider AuthStateProvider

<div class="layout-wrapper @(_sidebarOpen ? "" : "sidebar-collapsed")">

    <!-- ── Top Bar ─────────────────────────────── -->
    <header class="topbar">
        <div class="topbar-left">
            <button class="topbar-toggle" title="Afficher / masquer le menu" @onclick="ToggleSidebar">
                <i class="bi bi-list"></i>
            </button>
            <a class="topbar-brand" href="">
                <i class="bi bi-graph-up-arrow me-2"></i>T4C GestCom
            </a>
        </div>
        <div class="topbar-right">
            <span class="topbar-date d-none d-md-block">
                @DateTime.Now.ToString("dddd dd MMMM yyyy", new System.Globalization.CultureInfo("fr-FR"))
            </span>
            <div class="topbar-user">
                <div class="topbar-avatar">
                    @DisplayInitial
                </div>
                <span class="topbar-username d-none d-sm-block">@DisplayLogin</span>
                @if (!string.IsNullOrWhiteSpace(DisplayRole))
                {
                    <span class="badge @(DisplayRole switch {
                        "Admin"   => "bg-danger",
                        "Manager" => "bg-warning text-dark",
                        _         => "bg-secondary"
                    }) d-none d-md-inline" style="font-size:0.65rem">
                        @DisplayRole
                    </span>
                }
            </div>
        </div>
    </header>

    <!-- ── Sidebar ─────────────────────────────── -->
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <!-- ── Main Content ────────────────────────── -->
    <main class="main-content">
        @Body
    </main>

</div>

<div id="blazor-error-ui">
    Une erreur s'est produite.
    <a href="" class="reload">Recharger</a>
    <a class="dismiss">&#10006;</a>
</div>

@code {
    private bool _sidebarOpen = true;

    protected override async Task OnInitializedAsync()
    {
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        SyncCurrentUser(state);
    }

    private void OnAuthenticationStateChanged(Task<AuthenticationState> authStateTask)
    {
        _ = InvokeAsync(async () =>
        {
            var state = await authStateTask;
            SyncCurrentUser(state);
            StateHasChanged();
        });
    }

    private void SyncCurrentUser(AuthenticationState state)
    {
        if (state.User.Identity?.IsAuthenticated == true)
        {
            var login = state.User.Identity.Name ?? "utilisateur";
            var role  = state.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? RoleNameMapper.Employe;
            CurrentUserService.SetCurrentUser(login, role);
            return;
        }

        CurrentUserService.Clear();
    }

    private string DisplayLogin
        => CurrentUserService.IsAuthenticated && !string.IsNullOrWhiteSpace(CurrentUserService.Login)
            ? CurrentUserService.Login
            : "Invité";

    private string DisplayRole
        => CurrentUserService.IsAuthenticated ? CurrentUserService.Role : string.Empty;

    private string DisplayInitial
        => string.IsNullOrWhiteSpace(DisplayLogin)
            ? "U"
            : DisplayLogin[0].ToString().ToUpperInvariant();

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    public void Dispose()
        => AuthStateProvider.AuthenticationStateChanged -= OnAuthenticationStateChanged;
}
