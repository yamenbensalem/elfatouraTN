@using Microsoft.AspNetCore.Components.Authorization
@using Web_T4C_GestCom.Auth
@using Web_T4C_GestCom.Services
@inject IPermissionService PermissionService

@if (_show)
{
    @ChildContent
}
else if (Fallback is not null)
{
    @Fallback
}

@code {
    [Parameter, EditorRequired] public string Permission { get; set; } = string.Empty;
    [Parameter]                 public RenderFragment? ChildContent { get; set; }
    [Parameter]                 public RenderFragment? Fallback     { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _show;

    protected override async Task OnParametersSetAsync()
    {
        _show = false;
        if (AuthState is null) return;

        var state = await AuthState;
        var user  = state.User;
        if (!user.Identity?.IsAuthenticated ?? true) return;

        // Admin role bypasses all permission checks
        if (user.IsInRole("Admin")) { _show = true; return; }

        // Prefer claim-based checks injected by PermissionClaimsTransformation.
        if (user.HasClaim("Permission", Permission))
        {
            _show = true;
            return;
        }

        var userId = user.GetUserId();
        if (!userId.HasValue) return;

        _show = await PermissionService.HasPermissionAsync(userId.Value, Permission);
    }
}
