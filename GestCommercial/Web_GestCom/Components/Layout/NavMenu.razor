@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavManager
@implements IDisposable

<div class="sidebar-inner">

    <!-- Dashboard -->
    <div class="sidebar-section-item">
        <NavLink class="sidebar-link" href="" Match="NavLinkMatch.All">
            <i class="bi bi-speedometer2 sidebar-icon"></i>
            <span>Tableau de bord</span>
        </NavLink>
    </div>

    <div class="sidebar-separator"></div>

    <!-- ── VENTES ────────────────────────────── -->
    <details class="sidebar-group" open>
        <summary class="sidebar-group-header" aria-controls="nav-ventes">
            <div class="sidebar-group-title">
                <i class="bi bi-cart3 sidebar-icon"></i>
                <span>Ventes</span>
            </div>
            <i class="bi bi-chevron-down sidebar-chevron"></i>
        </summary>
        <div id="nav-ventes" class="sidebar-group-items-wrap">
            <div class="sidebar-group-items">
                <PermissionGuard Permission="clients.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="clients">
                        <i class="bi bi-people sidebar-icon"></i> Clients
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="devis.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="devis">
                        <i class="bi bi-file-earmark-text sidebar-icon"></i> Devis
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="commandes-vente.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="commandes-vente">
                        <i class="bi bi-bag-check sidebar-icon"></i> Commandes Vente
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="bons-livraison.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="bons-livraison">
                        <i class="bi bi-truck sidebar-icon"></i> Bons de Livraison
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="factures.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="factures-client">
                        <i class="bi bi-receipt sidebar-icon"></i> Factures Client
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="factures.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="avoirs">
                        <i class="bi bi-arrow-return-left sidebar-icon"></i> Avoirs
                    </NavLink>
                </PermissionGuard>
            </div>
        </div>
    </details>

    <!-- ── ACHATS ─────────────────────────────── -->
    <details class="sidebar-group" open>
        <summary class="sidebar-group-header" aria-controls="nav-achats">
            <div class="sidebar-group-title">
                <i class="bi bi-building sidebar-icon"></i>
                <span>Achats</span>
            </div>
            <i class="bi bi-chevron-down sidebar-chevron"></i>
        </summary>
        <div id="nav-achats" class="sidebar-group-items-wrap">
            <div class="sidebar-group-items">
                <PermissionGuard Permission="fournisseurs.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="fournisseurs">
                        <i class="bi bi-building sidebar-icon"></i> Fournisseurs
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="commandes-achat.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="commandes-achat">
                        <i class="bi bi-bag sidebar-icon"></i> Commandes Achat
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="bons-reception.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="bons-reception">
                        <i class="bi bi-box-arrow-in-down sidebar-icon"></i> Bons de Réception
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="factures-fournisseur.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="factures-fournisseur">
                        <i class="bi bi-receipt-cutoff sidebar-icon"></i> Factures Fournisseur
                    </NavLink>
                </PermissionGuard>
            </div>
        </div>
    </details>

    <!-- ── STOCK ──────────────────────────────── -->
    <details class="sidebar-group" open>
        <summary class="sidebar-group-header" aria-controls="nav-stock">
            <div class="sidebar-group-title">
                <i class="bi bi-boxes sidebar-icon"></i>
                <span>Stock</span>
            </div>
            <i class="bi bi-chevron-down sidebar-chevron"></i>
        </summary>
        <div id="nav-stock" class="sidebar-group-items-wrap">
            <div class="sidebar-group-items">
                <PermissionGuard Permission="produits.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="produits">
                        <i class="bi bi-boxes sidebar-icon"></i> Produits
                    </NavLink>
                </PermissionGuard>
                <PermissionGuard Permission="produits.view">
                    <NavLink class="sidebar-link sidebar-link-sub" href="stock">
                        <i class="bi bi-bar-chart-line sidebar-icon"></i> État du Stock
                    </NavLink>
                </PermissionGuard>
            </div>
        </div>
    </details>

    <!-- ── RAPPORTS ───────────────────────────── -->
    <div class="sidebar-section-item">
        <PermissionGuard Permission="factures.view">
            <NavLink class="sidebar-link" href="rapports/retenues">
                <i class="bi bi-file-earmark-ruled sidebar-icon"></i>
                <span>Retenues à la Source</span>
            </NavLink>
        </PermissionGuard>
    </div>

    <!-- ── PARAMÈTRES ─────────────────────────── -->
    @if (CanAccessAdministration)
    {
        <div class="sidebar-group">
            <button class="sidebar-group-header" type="button"
                    @onclick="ToggleParams"
                    aria-expanded="@_paramsOpen" aria-controls="nav-params">
                <div class="sidebar-group-title">
                    <i class="bi bi-gear sidebar-icon"></i>
                    <span>Paramètres</span>
                </div>
                <i class="bi bi-chevron-down sidebar-chevron"></i>
            </button>
            <div id="nav-params" class="sidebar-group-items-wrap" hidden="@(!_paramsOpen)">
                <div class="sidebar-group-items">
                    <NavLink class="sidebar-link sidebar-link-sub" href="entreprise">
                        <i class="bi bi-building-gear sidebar-icon"></i> Entreprise
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/tva">
                        <i class="bi bi-percent sidebar-icon"></i> Taux de TVA
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/categories">
                        <i class="bi bi-tags sidebar-icon"></i> Catégories
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/unites">
                        <i class="bi bi-rulers sidebar-icon"></i> Unités
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/modes-payement">
                        <i class="bi bi-credit-card sidebar-icon"></i> Modes de Paiement
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/devises">
                        <i class="bi bi-currency-exchange sidebar-icon"></i> Devises
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="parametres/fabricants">
                        <i class="bi bi-award sidebar-icon"></i> Fabricants
                    </NavLink>
                </div>
            </div>
        </div>
    }

    <!-- ── ADMINISTRATION (Admin only) ───────── -->
    @if (CanAccessAdministration)
    {
        <div class="sidebar-group">
            <button class="sidebar-group-header" type="button"
                    @onclick="ToggleAdmin"
                    aria-expanded="@_adminOpen" aria-controls="nav-admin">
                <div class="sidebar-group-title">
                    <i class="bi bi-shield-lock sidebar-icon"></i>
                    <span>Administration</span>
                </div>
                <i class="bi bi-chevron-down sidebar-chevron"></i>
            </button>
            <div id="nav-admin" class="sidebar-group-items-wrap" hidden="@(!_adminOpen)">
                <div class="sidebar-group-items">
                    <NavLink class="sidebar-link sidebar-link-sub" href="admin/utilisateurs">
                        <i class="bi bi-person-lock sidebar-icon"></i> Utilisateurs
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="admin/roles">
                        <i class="bi bi-person-badge sidebar-icon"></i> Rôles &amp; Permissions
                    </NavLink>
                    <NavLink class="sidebar-link sidebar-link-sub" href="admin/journal">
                        <i class="bi bi-journal-text sidebar-icon"></i> Journal d'Activité
                    </NavLink>
                    @if (CurrentUserService.IsSuperAdmin)
                    {
                        <NavLink class="sidebar-link sidebar-link-sub" href="admin/entreprises">
                            <i class="bi bi-diagram-3 sidebar-icon"></i> Entreprises
                        </NavLink>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── User footer ────────────────────────── -->
    <div class="sidebar-user-strip">
        <div class="sidebar-user-avatar">
            @(CurrentUserService.Login.Length > 0
                ? CurrentUserService.Login[0].ToString().ToUpper()
                : "U")
        </div>
        <div class="flex-grow-1 overflow-hidden">
            <div class="sidebar-user-name">@CurrentUserService.Login</div>
            <span class="badge @(CurrentUserService.Role switch {
                "Admin"   => "bg-danger",
                "Manager" => "bg-warning text-dark",
                _         => "bg-secondary"
            })" style="font-size:0.62rem">@CurrentUserService.Role</span>
        </div>
    </div>

    <div class="sidebar-logout">
        <a class="sidebar-link text-danger" href="/compte/deconnexion">
            <i class="bi bi-box-arrow-right sidebar-icon"></i>
            <span>Déconnecter</span>
        </a>
    </div>

    <div class="sidebar-credit">
        Développé par <a href="https://aivorconsulting.com/" target="_blank" rel="noopener noreferrer">AIVOR Consulting</a>
    </div>

</div>

@code {
    private bool _paramsOpen = true;
    private bool _adminOpen = true;
    private bool CanAccessAdministration => CurrentUserService.IsAdmin || CurrentUserService.IsSuperAdmin;

    protected override void OnInitialized()
    {
        OpenSectionForPath(NavManager.ToBaseRelativePath(NavManager.Uri));
        NavManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        OpenSectionForPath(NavManager.ToBaseRelativePath(e.Location));
        _ = InvokeAsync(StateHasChanged);
    }

    private void ToggleParams() => _paramsOpen = !_paramsOpen;
    private void ToggleAdmin() => _adminOpen = !_adminOpen;

    private void OpenSectionForPath(string path)
    {
        var p = (path ?? string.Empty).Trim('/').ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(p))
            return;

        if (StartsWithAny(p, "entreprise", "parametres"))
            _paramsOpen = true;

        if (StartsWithAny(p, "admin"))
            _adminOpen = true; // covers admin/utilisateurs, admin/roles, admin/journal, admin/entreprises
    }

    private static bool StartsWithAny(string value, params string[] prefixes)
    {
        foreach (var prefix in prefixes)
        {
            if (value.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                return true;
        }

        return false;
    }

    public void Dispose()
        => NavManager.LocationChanged -= OnLocationChanged;
}
