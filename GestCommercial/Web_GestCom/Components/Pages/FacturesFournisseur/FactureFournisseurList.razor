@page "/factures-fournisseur"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:factures-fournisseur.view")]
@inject IFactureFournisseurService FactureService
@inject NavigationManager Nav

<PageTitle>Factures Fournisseur – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Factures Fournisseur</h3>
    <a href="/factures-fournisseur/nouveau" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvelle Facture
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label small mb-1">Fournisseur</label>
            <select class="form-select form-select-sm" style="min-width:160px" @bind="_filterFournisseur">
                <option value="">Tous</option>
                @foreach (var f in FournisseursDistincts)
                { <option value="@f.CodeFournisseur">@f.NomFournisseur</option> }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">État</label>
            <select class="form-select form-select-sm" style="min-width:150px" @bind="_filterEtat">
                <option value="">Tous</option>
                <option value="Facture Ouverte">Facture Ouverte</option>
                <option value="Facture Validée">Facture Validée</option>
                <option value="Facture Annulée">Facture Annulée</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Du</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterDebut" />
        </div>
        <div>
            <label class="form-label small mb-1">Au</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterFin" />
        </div>
        <button class="btn btn-sm btn-outline-secondary mb-0" @onclick="ResetFilters">
            <i class="bi bi-x-circle"></i> Réinitialiser
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Facture</th>
                        <th>Date</th>
                        <th>Fournisseur</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Timbre</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th>Règlement</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in FilteredFactures)
                    {
                        <tr>
                            <td><a href="/factures-fournisseur/@f.NumeroFactureFournisseur">@f.NumeroFactureFournisseur</a></td>
                            <td>@f.DateFactureFournisseur.ToString("dd/MM/yyyy")</td>
                            <td>@f.Fournisseur?.NomFournisseur</td>
                            <td class="text-end">@f.MontantHT.ToString("0.###")</td>
                            <td class="text-end">@f.MontantTVA.ToString("0.###")</td>
                            <td class="text-end">@f.Timbre.ToString("0.###")</td>
                            <td class="text-end fw-bold">@((f.MontantTTC + f.Timbre).ToString("0.###"))</td>
                            <td><span class="badge bg-secondary">@f.EtatFacture</span></td>
                            <td>
                                <span class="badge @GetReglementBadge(f.EtatReglement)">@f.EtatReglement</span>
                            </td>
                            <td class="text-end">
                                <PermissionGuard Permission="factures-fournisseur.update">
                                    <a href="/factures-fournisseur/@f.NumeroFactureFournisseur"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Modifier
                                    </a>
                                </PermissionGuard>
                                <button class="btn btn-sm btn-outline-info me-1"
                                        @onclick="() => CloneFacture(f.NumeroFactureFournisseur)">
                                    <i class="bi bi-copy me-1"></i>Cloner
                                </button>
                                <PermissionGuard Permission="factures-fournisseur.delete">
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => AskDelete(f)">
                                        <i class="bi bi-trash me-1"></i>Supprimer
                                    </button>
                                </PermissionGuard>
                            </td>
                        </tr>
                    }
                    @if (!FilteredFactures.Any())
                    {
                        <tr><td colspan="10" class="text-center text-muted py-4">Aucune facture trouvée.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@FilteredFactures.Count() / @_factures.Count facture(s)</div>
</div>

<ConfirmDialog Title="Supprimer la facture"
               Message="@($"Confirmer la suppression de {_toDelete?.NumeroFactureFournisseur} ? Le stock sera restitué.")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<FactureFournisseur> _factures = [];
    private bool _loading = true;
    private bool _confirmVisible;
    private FactureFournisseur? _toDelete;
    private Notification _notif = default!;

    private string? _filterFournisseur;
    private string? _filterEtat;
    private DateTime? _filterDebut;
    private DateTime? _filterFin;

    private IEnumerable<FactureFournisseur> FilteredFactures => _factures.Where(f =>
        (string.IsNullOrEmpty(_filterFournisseur) || f.CodeFournisseur == _filterFournisseur) &&
        (string.IsNullOrEmpty(_filterEtat) || f.EtatFacture == _filterEtat) &&
        (!_filterDebut.HasValue || f.DateFactureFournisseur.Date >= _filterDebut.Value.Date) &&
        (!_filterFin.HasValue || f.DateFactureFournisseur.Date <= _filterFin.Value.Date));

    private List<Fournisseur> FournisseursDistincts => _factures
        .Where(f => f.Fournisseur is not null)
        .Select(f => f.Fournisseur!)
        .DistinctBy(f => f.CodeFournisseur)
        .OrderBy(f => f.NomFournisseur)
        .ToList();

    private void ResetFilters()
    {
        _filterFournisseur = null;
        _filterEtat = null;
        _filterDebut = null;
        _filterFin = null;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _factures = await FactureService.GetAllAsync();
        _loading = false;
    }

    private async Task CloneFacture(string numero)
    {
        try
        {
            var clone = await FactureService.CloneAsync(numero);
            _notif.ShowSuccess($"Facture clonée : {clone.NumeroFactureFournisseur}");
            await LoadAsync();
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private void AskDelete(FactureFournisseur f) { _toDelete = f; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        try
        {
            await FactureService.DeleteAsync(_toDelete.NumeroFactureFournisseur);
            _notif.ShowSuccess("Facture supprimée.");
            _toDelete = null;
            await LoadAsync();
        }
        catch (Exception ex) { _notif.ShowError($"Erreur : {ex.Message}"); }
    }

    private static string GetReglementBadge(string etat) => etat switch
    {
        "Réglé" => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _ => "bg-danger"
    };
}
