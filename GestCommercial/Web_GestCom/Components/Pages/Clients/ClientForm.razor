@page "/clients/nouveau"
@page "/clients/{Code}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:clients.view")]
@inject IClientService ClientService
@inject NavigationManager Nav
@inject AppDbContext Db

<PageTitle>@(_isNew ? "Nouveau Client" : "Modifier Client") – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isNew ? "Nouveau Client" : $"Client : {_client.NomClient}")</h3>
    <a href="clients" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Retour
    </a>
</div>

<Notification @ref="_notif" />
<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <EditForm Model="_client" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Informations Générales</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Code Client</label>
                        <InputText class="form-control" @bind-Value="_client.CodeClient" disabled="@(!_isNew)" placeholder="Auto-généré" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Nom <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_client.NomClient" />
                        <ValidationMessage For="() => _client.NomClient" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Matricule Fiscale</label>
                        <InputText class="form-control" @bind-Value="_client.MatriculeFiscale" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Type Personne</label>
                        <InputSelect class="form-select" @bind-Value="_client.TypePersonne">
                            <option value="Physique">Physique</option>
                            <option value="Morale">Morale</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Devise</label>
                        <InputSelect class="form-select" @bind-Value="_client.CodeDevise">
                            @foreach (var d in _devises)
                            {
                                <option value="@d.CodeDevise">@d.NomDevise</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Étranger</label>
                        <InputSelect class="form-select" @bind-Value="_client.Etranger">
                            <option value="NON">Non</option>
                            <option value="OUI">Oui</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Exonéré TVA</label>
                        <InputSelect class="form-select" @bind-Value="_client.Exonore">
                            <option value="NON">Non</option>
                            <option value="OUI">Oui</option>
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Coordonnées</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Adresse</label>
                        <InputText class="form-control" @bind-Value="_client.Adresse" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Code Postal</label>
                        <InputText class="form-control" @bind-Value="_client.CodePostal" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Ville</label>
                        <InputText class="form-control" @bind-Value="_client.Ville" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Pays</label>
                        <InputText class="form-control" @bind-Value="_client.Pays" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Téléphone</label>
                        <InputText class="form-control" @bind-Value="_client.Tel" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Mobile</label>
                        <InputText class="form-control" @bind-Value="_client.TelMobile" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fax</label>
                        <InputText class="form-control" @bind-Value="_client.Fax" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Email</label>
                        <InputText class="form-control" @bind-Value="_client.Email" type="email" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Informations Commerciales</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Crédit Maximum</label>
                        <InputNumber class="form-control" @bind-Value="_client.MaxCredit" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">RIB</label>
                        <InputText class="form-control" @bind-Value="_client.Rib" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Responsable</label>
                        <InputText class="form-control" @bind-Value="_client.Responsable" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">État</label>
                        <InputSelect class="form-select" @bind-Value="_client.EtatClient">
                            <option value="Actif">Actif</option>
                            <option value="Inactif">Inactif</option>
                        </InputSelect>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Note</label>
                        <InputTextArea class="form-control" @bind-Value="_client.Note" rows="2" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <PermissionGuard Permission="@(_isNew ? "clients.create" : "clients.update")">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Enregistrer
                </button>
            </PermissionGuard>
            <a href="clients" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string? Code { get; set; }

    private Client _client = new();
    private List<Devise> _devises = [];
    private bool _loading = true;
    private bool _isNew => string.IsNullOrEmpty(Code);
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _devises = await Db.Devises.ToListAsync();
        if (!_isNew)
        {
            var existing = await ClientService.GetByCodeAsync(Code!);
            if (existing is not null) _client = existing;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_isNew)
                await ClientService.AddAsync(_client);
            else
                await ClientService.UpdateAsync(_client);

            Nav.NavigateTo("clients");
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }
}
