@page "/"
@rendermode InteractiveServer
@using System.Globalization
@inject IClientService ClientService
@inject IProduitService ProduitService
@inject IFournisseurService FournisseurService
@inject IFactureClientService FactureService
@inject ICompanyService CompanyService
@inject ICurrentUserService CurrentUserService

@if (!CurrentUserService.IsAuthenticated)
{
    <!-- Public landing page — anonymous visitors only. MainLayout itself omits the topbar/
         sidebar app shell for anonymous visitors, so this renders full-bleed like the login
         screen. Matches Direction A of the design mockup approved by the user, with the blue
         gradient they picked over the login screen's violet one. -->
    <PageTitle>GestCom – Gestion Commerciale</PageTitle>

    <div style="background:#ffffff;">

            <!-- ── Header ── -->
            <header style="display:flex; align-items:center; justify-content:space-between; padding:1.1rem 4rem; border-bottom:1px solid #f0f0f4;">
                <div style="display:flex; align-items:center; gap:0.75rem;">
                    <div style="width:42px; height:42px; border-radius:0.9rem; background:linear-gradient(145deg,#2563eb,#3b82f6); display:flex; align-items:center; justify-content:center; box-shadow:0 6px 16px rgba(37,99,235,0.35);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="white" viewBox="0 0 16 16">
                            <path d="M1 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zM1 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1zM1 12a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1z"/>
                        </svg>
                    </div>
                    <div>
                        <div style="font-size:1.25rem; font-weight:800; color:#1e1b4b; letter-spacing:-0.02em; line-height:1.1;">GestCom</div>
                        <div style="font-size:0.72rem; color:#6b7280;">Gestion Commerciale</div>
                    </div>
                </div>
                <a href="/compte/connexion" style="padding:0.65rem 1.5rem; border-radius:0.65rem; background:linear-gradient(135deg,#2563eb,#3b82f6,#6366f1); color:#fff; font-weight:700; font-size:0.9rem; box-shadow:0 4px 15px rgba(59,130,246,0.35); text-decoration:none;">Se connecter</a>
            </header>

            <!-- ── Hero ── -->
            <section style="background:linear-gradient(145deg,#2563eb 0%,#3b82f6 55%,#6366f1 100%); padding:5.5rem 4rem 6.5rem; text-align:center;">
                <div style="max-width:760px; margin:0 auto;">
                    <div style="display:inline-flex; align-items:center; gap:0.5rem; background:rgba(255,255,255,0.16); color:#fff; padding:0.4rem 0.9rem; border-radius:2rem; font-size:0.8rem; font-weight:600; margin-bottom:1.75rem;">
                        <i class="bi bi-check-circle-fill"></i>
                        Pensé pour la fiscalité tunisienne
                    </div>
                    <h1 style="font-size:3rem; font-weight:800; color:#fff; letter-spacing:-0.02em; line-height:1.15; margin:0 0 1.25rem;">La gestion commerciale simplifiée pour les entreprises tunisiennes</h1>
                    <p style="font-size:1.15rem; color:rgba(255,255,255,0.88); line-height:1.6; margin:0 0 2.25rem;">Devis, commandes, factures, stock et rapports — tout votre cycle commercial dans une seule plateforme, avec la TVA, le timbre fiscal et la retenue à la source déjà pris en compte.</p>
                    <a href="/compte/connexion" style="display:inline-block; padding:0.95rem 2.25rem; border-radius:0.65rem; background:#fff; color:#1d4ed8; font-weight:700; font-size:1rem; box-shadow:0 12px 30px rgba(0,0,0,0.2); text-decoration:none;">Se connecter</a>
                </div>
            </section>

            <!-- ── Fiscal band ── -->
            <section style="padding:2.75rem 4rem; border-bottom:1px solid #f0f0f4;">
                <div style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:2rem;">
                    <div style="display:flex; align-items:center; gap:0.85rem;">
                        <div style="width:44px; height:44px; flex-shrink:0; border-radius:0.65rem; background:#dbeafe; color:#2563eb; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-percent" style="font-size:1.2rem;"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#111827; font-size:0.92rem;">TVA 19 · 13 · 7 %</div>
                            <div style="font-size:0.78rem; color:#6b7280;">Taux tunisiens intégrés</div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.85rem;">
                        <div style="width:44px; height:44px; flex-shrink:0; border-radius:0.65rem; background:#e0e7ff; color:#4f46e5; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-patch-check-fill" style="font-size:1.2rem;"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#111827; font-size:0.92rem;">Timbre fiscal</div>
                            <div style="font-size:0.78rem; color:#6b7280;">Appliqué automatiquement</div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.85rem;">
                        <div style="width:44px; height:44px; flex-shrink:0; border-radius:0.65rem; background:#ede9fe; color:#7c3aed; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-cash-coin" style="font-size:1.2rem;"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#111827; font-size:0.92rem;">Retenue à la source</div>
                            <div style="font-size:0.78rem; color:#6b7280;">Calculée sur chaque facture</div>
                        </div>
                    </div>
                    <div style="display:flex; align-items:center; gap:0.85rem;">
                        <div style="width:44px; height:44px; flex-shrink:0; border-radius:0.65rem; background:#dbeafe; color:#1d4ed8; display:flex; align-items:center; justify-content:center;">
                            <i class="bi bi-currency-exchange" style="font-size:1.2rem;"></i>
                        </div>
                        <div>
                            <div style="font-weight:700; color:#111827; font-size:0.92rem;">Dinar Tunisien (TND)</div>
                            <div style="font-size:0.78rem; color:#6b7280;">Devise par défaut, multi-devises</div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ── Modules ── -->
            <section style="padding:5rem 4rem; background:#fafafc;">
                <div style="max-width:1100px; margin:0 auto;">
                    <div style="text-align:center; margin-bottom:3rem;">
                        <h2 style="font-size:2rem; font-weight:800; color:#111827; letter-spacing:-0.01em; margin:0 0 0.6rem;">Tout votre cycle commercial, en un seul endroit</h2>
                        <p style="font-size:1rem; color:#6b7280; margin:0;">Quatre modules qui couvrent la vente, l'achat, le stock et le pilotage de l'activité.</p>
                    </div>

                    <div style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:1.5rem;">

                        <div style="background:#fff; border:1px solid #f0f0f4; border-radius:1.25rem; padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
                            <div style="width:48px; height:48px; border-radius:0.7rem; background:#e8f0fe; color:#1a73e8; display:flex; align-items:center; justify-content:center; margin-bottom:1.1rem;">
                                <i class="bi bi-cart3" style="font-size:1.4rem;"></i>
                            </div>
                            <h3 style="font-size:1.15rem; font-weight:700; color:#111827; margin:0 0 0.4rem;">Ventes</h3>
                            <p style="font-size:0.85rem; color:#6b7280; margin:0 0 1rem; line-height:1.5;">Du devis à la facture, avec livraison et avoirs.</p>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Clients</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Devis</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Commandes Vente</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Bons de Livraison</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Factures</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Avoirs</span>
                            </div>
                        </div>

                        <div style="background:#fff; border:1px solid #f0f0f4; border-radius:1.25rem; padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
                            <div style="width:48px; height:48px; border-radius:0.7rem; background:#d1fae5; color:#059669; display:flex; align-items:center; justify-content:center; margin-bottom:1.1rem;">
                                <i class="bi bi-building" style="font-size:1.4rem;"></i>
                            </div>
                            <h3 style="font-size:1.15rem; font-weight:700; color:#111827; margin:0 0 0.4rem;">Achats</h3>
                            <p style="font-size:0.85rem; color:#6b7280; margin:0 0 1rem; line-height:1.5;">Du fournisseur à la facture, avec réception contrôlée.</p>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Fournisseurs</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Commandes Achat</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Bons de Réception</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Factures Fournisseur</span>
                            </div>
                        </div>

                        <div style="background:#fff; border:1px solid #f0f0f4; border-radius:1.25rem; padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
                            <div style="width:48px; height:48px; border-radius:0.7rem; background:#f3e8ff; color:#7c3aed; display:flex; align-items:center; justify-content:center; margin-bottom:1.1rem;">
                                <i class="bi bi-boxes" style="font-size:1.4rem;"></i>
                            </div>
                            <h3 style="font-size:1.15rem; font-weight:700; color:#111827; margin:0 0 0.4rem;">Stock</h3>
                            <p style="font-size:0.85rem; color:#6b7280; margin:0 0 1rem; line-height:1.5;">Mouvements automatiques et alertes de seuil minimal.</p>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Produits</span>
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">État du Stock</span>
                            </div>
                        </div>

                        <div style="background:#fff; border:1px solid #f0f0f4; border-radius:1.25rem; padding:1.75rem; box-shadow:0 4px 20px rgba(0,0,0,0.04);">
                            <div style="width:48px; height:48px; border-radius:0.7rem; background:#fee2e2; color:#dc2626; display:flex; align-items:center; justify-content:center; margin-bottom:1.1rem;">
                                <i class="bi bi-file-earmark-ruled" style="font-size:1.4rem;"></i>
                            </div>
                            <h3 style="font-size:1.15rem; font-weight:700; color:#111827; margin:0 0 0.4rem;">Rapports</h3>
                            <p style="font-size:0.85rem; color:#6b7280; margin:0 0 1rem; line-height:1.5;">Le suivi fiscal spécifique à l'activité tunisienne.</p>
                            <div style="display:flex; flex-wrap:wrap; gap:0.5rem;">
                                <span style="background:#f3f4f6; color:#374151; font-size:0.76rem; font-weight:600; padding:0.3rem 0.7rem; border-radius:2rem;">Retenues à la Source</span>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- ── CTA band ── -->
            <section style="background:linear-gradient(145deg,#2563eb 0%,#3b82f6 55%,#6366f1 100%); padding:4rem; text-align:center;">
                <h2 style="font-size:1.75rem; font-weight:800; color:#fff; margin:0 0 1.5rem;">Accédez à votre espace de gestion</h2>
                <a href="/compte/connexion" style="display:inline-block; padding:0.95rem 2.25rem; border-radius:0.65rem; background:#fff; color:#1d4ed8; font-weight:700; font-size:1rem; box-shadow:0 12px 30px rgba(0,0,0,0.2); text-decoration:none;">Se connecter</a>
            </section>

            <!-- ── Footer ── -->
            <footer style="text-align:center; padding:2rem; font-size:0.8rem; color:#9ca3af;">
                © 2026 GestCom – Tous droits réservés<br />
                Développé par <a href="https://aivorconsulting.com/" target="_blank" rel="noopener noreferrer" style="color:#2563eb; font-weight:600;">AIVOR Consulting</a>
            </footer>

    </div>
}
else if (CurrentUserService.IsSuperAdmin)
{
    <PageTitle>Tableau de bord – GestCom</PageTitle>
    <!-- SuperAdmin dashboard: platform-management summary only — no business data (clients,
         factures, produits, ...) is ever loaded or shown here, per its zero-business-access
         design (see PermissionAuthorizationHandler / ServicePermissionGuard / AppDbContext). -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1">Bienvenue, <span class="text-primary">@CurrentUserService.Login</span> 👋</h4>
        <p class="text-muted mb-0">Gestion globale de la plateforme</p>
    </div>

    <LoadingSpinner Loading="@_platformLoading" />

    @if (!_platformLoading)
    {
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card kpi-card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="kpi-icon-wrap" style="background:#e8f0fe">
                            <i class="bi bi-diagram-3" style="color:#1a73e8;font-size:1.4rem"></i>
                        </div>
                        <div>
                            <div class="kpi-value">@_nbEntreprises</div>
                            <div class="kpi-label">Entreprises</div>
                        </div>
                    </div>
                    <div class="kpi-footer">
                        <a href="admin/entreprises" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-right me-1"></i>Gérer les entreprises
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card kpi-card h-100">
                    <div class="card-body d-flex align-items-center gap-3">
                        <div class="kpi-icon-wrap" style="background:#f3e8ff">
                            <i class="bi bi-people-fill" style="color:#7c3aed;font-size:1.4rem"></i>
                        </div>
                        <div>
                            <div class="kpi-value">@_nbUtilisateurs</div>
                            <div class="kpi-label">Utilisateurs</div>
                        </div>
                    </div>
                    <div class="kpi-footer">
                        <a href="admin/utilisateurs-global" class="text-decoration-none text-muted small">
                            <i class="bi bi-arrow-right me-1"></i>Voir tous les utilisateurs
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header fw-semibold">
                <i class="bi bi-hdd-network me-1 text-primary"></i>
                Accès rapides
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    <a href="admin/roles" class="btn btn-outline-secondary btn-action-quick">
                        <i class="bi bi-person-badge me-2"></i>Rôles &amp; Permissions
                    </a>
                    <a href="admin/journal" class="btn btn-outline-secondary btn-action-quick">
                        <i class="bi bi-journal-text me-2"></i>Journal d'Activité
                    </a>
                    <a href="admin/cles-api" class="btn btn-outline-secondary btn-action-quick">
                        <i class="bi bi-key me-2"></i>Clés d'API
                    </a>
                    <a href="admin/webhooks" class="btn btn-outline-secondary btn-action-quick">
                        <i class="bi bi-broadcast me-2"></i>Webhooks
                    </a>
                </div>
            </div>
        </div>
    }
}
else
{
    <PageTitle>Tableau de bord – GestCom</PageTitle>
    <!-- Greeting -->
    <div class="mb-4">
        <h4 class="fw-bold mb-1">Bienvenue, <span class="text-primary">@CurrentUserService.Login</span> 👋</h4>
        <p class="text-muted mb-0">Voici un aperçu de votre activité commerciale</p>
    </div>

    <LoadingSpinner Loading="@_loading" />

    @if (!_loading)
    {
    <!-- ── KPI Cards ───────────────────────────── -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#e8f0fe">
                        <i class="bi bi-people" style="color:#1a73e8;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbClients</div>
                        <div class="kpi-label">Total Clients</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="clients" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les clients
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#f3e8ff">
                        <i class="bi bi-boxes" style="color:#7c3aed;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbProduits</div>
                        <div class="kpi-label">Total Produits</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="produits" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les produits
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#d1fae5">
                        <i class="bi bi-building" style="color:#059669;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbFournisseurs</div>
                        <div class="kpi-label">Fournisseurs</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="fournisseurs" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les fournisseurs
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#fee2e2">
                        <i class="bi bi-receipt" style="color:#dc2626;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbFacturesOuvertes</div>
                        <div class="kpi-label">Factures en attente</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="factures-client" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les factures
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#fef3c7">
                        <i class="bi bi-cash-stack" style="color:#d97706;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_montantNonRegle.ToString("0.###")</div>
                        <div class="kpi-label">Montant Impayé (TND)</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="factures-client" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les factures
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#ccfbf1">
                        <i class="bi bi-graph-up-arrow" style="color:#0d9488;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_caDuMois.ToString("0.###")</div>
                        <div class="kpi-label">CA du Mois (TND)</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted small">
                        <i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("MMMM yyyy", _frCulture)
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- ── Graphique CA mensuel ───────────────── -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-bar-chart-line me-1 text-primary"></i>
            Chiffre d'affaires mensuel — 6 derniers mois
        </div>
        <div class="card-body">
            <div class="d-flex align-items-end gap-2" style="height:170px">
                @foreach (var m in _caMensuel)
                {
                    var heightPct = _caMensuelMax > 0 ? Math.Max(3, m.Montant / _caMensuelMax * 100) : 3;
                    <div class="d-flex flex-column align-items-center flex-fill h-100 justify-content-end">
                        <div class="small text-muted mb-1">@m.Montant.ToString("0")</div>
                        <div class="w-75 rounded-top" style="height:@(heightPct.ToString("0.##", CultureInfo.InvariantCulture))%;background:linear-gradient(180deg,#4f46e5,#7c3aed);min-height:3px"></div>
                        <div class="small text-muted mt-2 text-capitalize">@m.Label</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Stock alerts -->
    @if (_alerteStock.Any())
    {
        <div class="card border-warning mb-4">
            <div class="card-header text-warning fw-semibold">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Alertes Stock — @_alerteStock.Count produit(s) sous le seuil minimal
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th><th>Désignation</th>
                            <th class="text-end">Stock actuel</th>
                            <th class="text-end">Seuil minimal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _alerteStock.Take(10))
                        {
                            <tr>
                                <td><code>@p.CodeProduit</code></td>
                                <td>@p.DesignationProduit</td>
                                <td class="text-end text-danger fw-bold">@p.Quantite.ToString("0.###")</td>
                                <td class="text-end text-muted">@p.StockMinimal.ToString("0.###")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── Actions Rapides ────────────────────── -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                <span class="fw-semibold fs-6">Actions Rapides</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="clients/nouveau" class="btn btn-primary btn-action-quick">
                    <i class="bi bi-person-plus me-2"></i>Nouveau Client
                </a>
                <a href="factures-client/nouveau" class="btn btn-success btn-action-quick">
                    <i class="bi bi-receipt me-2"></i>Nouvelle Facture
                </a>
                <a href="devis/nouveau" class="btn btn-action-quick" style="background:#7c3aed;color:#fff;border-color:#7c3aed">
                    <i class="bi bi-file-earmark-text me-2"></i>Nouveau Devis
                </a>
                <a href="produits/nouveau" class="btn btn-warning btn-action-quick">
                    <i class="bi bi-box-seam me-2"></i>Nouveau Produit
                </a>
            </div>
        </div>
    </div>

    <!-- ── Activité Récente ───────────────────── -->
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-clock-history me-1 text-primary"></i>
                Activité Récente
            </span>
            <a href="factures-client" class="btn btn-sm btn-outline-secondary">Tout voir</a>
        </div>
        <div class="card-body p-0">
            @if (_dernieresFactures.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var f in _dernieresFactures)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="activity-icon-wrap" style="background:#e8f0fe">
                                <i class="bi bi-receipt" style="color:#1a73e8"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">
                                    Facture
                                    <a href="factures-client/@f.NumeroFactureClient">@f.NumeroFactureClient</a>
                                    —
                                    @f.Client?.NomClient
                                </div>
                                <div class="text-muted" style="font-size:0.78rem">
                                    Montant TTC : <strong>@f.MontantTTC.ToString("0.###") TND</strong>
                                    &nbsp;·&nbsp;
                                    <span class="badge @GetEtatBadge(f.EtatReglement)">@f.EtatReglement</span>
                                </div>
                            </div>
                            <span class="text-muted" style="font-size:0.75rem;white-space:nowrap">
                                @f.DateFactureClient.ToString("dd/MM/yyyy")
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Aucune activité récente.
                </div>
            }
        </div>
    </div>
    }
}

@code {
    private static readonly CultureInfo _frCulture = CultureInfo.GetCultureInfo("fr-FR");

    private bool _loading = true;
    private int _nbClients, _nbProduits, _nbFournisseurs, _nbFacturesOuvertes;
    private double _montantNonRegle;
    private double _caDuMois;
    private double _caMensuelMax;
    private List<FactureClient> _dernieresFactures = [];
    private List<Produit> _alerteStock = [];
    private List<(string Label, double Montant)> _caMensuel = [];

    private bool _platformLoading = true;
    private int _nbEntreprises;
    private int _nbUtilisateurs;

    protected override async Task OnInitializedAsync()
    {
        // Anonymous visitors get the public landing page (see the markup above) — no business
        // or platform data is ever loaded for them.
        if (!CurrentUserService.IsAuthenticated)
            return;

        if (CurrentUserService.IsSuperAdmin)
        {
            var companies = await CompanyService.GetAllAsync();
            _nbEntreprises  = companies.Count;
            _nbUtilisateurs = companies.Sum(c => c.Utilisateurs.Count);
            _platformLoading = false;
            return;
        }

        var clients      = await ClientService.GetAllAsync();
        var produits     = await ProduitService.GetAllAsync();
        var fournisseurs = await FournisseurService.GetAllAsync();
        var factures     = await FactureService.GetAllAsync();
        var avoirs       = await FactureService.GetAllAsync(avoirsOnly: true);

        _nbClients          = clients.Count;
        _nbProduits         = produits.Count;
        _nbFournisseurs     = fournisseurs.Count;
        _nbFacturesOuvertes = factures.Count(f => f.EtatReglement != "Réglé");
        _montantNonRegle    = factures
            .Where(f => f.EtatReglement != "Réglé")
            .Sum(f => f.MontantTTC + f.Timbre - f.Reglements.Sum(r => r.Montant));
        _dernieresFactures  = factures.Take(5).ToList();
        _alerteStock        = await ProduitService.GetStockAlerteAsync();

        var today = DateTime.Today;
        _caDuMois = ChiffreAffairesDuMois(factures, avoirs, today.Year, today.Month);

        _caMensuel = Enumerable.Range(0, 6)
            .Select(i => today.AddMonths(-(5 - i)))
            .Select(mois => (
                Label: mois.ToString("MMM yy", _frCulture),
                Montant: ChiffreAffairesDuMois(factures, avoirs, mois.Year, mois.Month)))
            .ToList();
        _caMensuelMax = _caMensuel.Count > 0 ? _caMensuel.Max(m => m.Montant) : 0;

        _loading = false;
    }

    private static double ChiffreAffairesDuMois(List<FactureClient> factures, List<FactureClient> avoirs, int year, int month)
    {
        var ventes = factures.Where(f => f.DateFactureClient.Year == year && f.DateFactureClient.Month == month).Sum(f => f.MontantTTC);
        var retours = avoirs.Where(a => a.DateFactureClient.Year == year && a.DateFactureClient.Month == month).Sum(a => a.MontantTTC);
        return ventes - retours;
    }

    private static string GetEtatBadge(string etat) => etat switch
    {
        "Réglé"               => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _                     => "bg-danger"
    };
}
