@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Globalization
@inject IClientService ClientService
@inject IProduitService ProduitService
@inject IFournisseurService FournisseurService
@inject IFactureClientService FactureService
@inject ICurrentUserService CurrentUserService

<PageTitle>Tableau de bord – GestCom</PageTitle>

<!-- Greeting -->
<div class="mb-4">
    <h4 class="fw-bold mb-1">Bienvenue, <span class="text-primary">@CurrentUserService.Login</span> 👋</h4>
    <p class="text-muted mb-0">Voici un aperçu de votre activité commerciale</p>
</div>

<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <!-- ── KPI Cards ───────────────────────────── -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#e8f0fe">
                        <i class="bi bi-people" style="color:#1a73e8;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbClients</div>
                        <div class="kpi-label">Total Clients</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="clients" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les clients
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#f3e8ff">
                        <i class="bi bi-boxes" style="color:#7c3aed;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbProduits</div>
                        <div class="kpi-label">Total Produits</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="produits" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les produits
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#d1fae5">
                        <i class="bi bi-building" style="color:#059669;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbFournisseurs</div>
                        <div class="kpi-label">Fournisseurs</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="fournisseurs" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les fournisseurs
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#fee2e2">
                        <i class="bi bi-receipt" style="color:#dc2626;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_nbFacturesOuvertes</div>
                        <div class="kpi-label">Factures en attente</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="factures-client" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les factures
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#fef3c7">
                        <i class="bi bi-cash-stack" style="color:#d97706;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_montantNonRegle.ToString("0.###")</div>
                        <div class="kpi-label">Montant Impayé (TND)</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <a href="factures-client" class="text-decoration-none text-muted small">
                        <i class="bi bi-arrow-right me-1"></i>Voir les factures
                    </a>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-3">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="kpi-icon-wrap" style="background:#ccfbf1">
                        <i class="bi bi-graph-up-arrow" style="color:#0d9488;font-size:1.4rem"></i>
                    </div>
                    <div>
                        <div class="kpi-value">@_caDuMois.ToString("0.###")</div>
                        <div class="kpi-label">CA du Mois (TND)</div>
                    </div>
                </div>
                <div class="kpi-footer">
                    <span class="text-muted small">
                        <i class="bi bi-calendar3 me-1"></i>@DateTime.Today.ToString("MMMM yyyy", _frCulture)
                    </span>
                </div>
            </div>
        </div>

    </div>

    <!-- ── Graphique CA mensuel ───────────────── -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header fw-semibold">
            <i class="bi bi-bar-chart-line me-1 text-primary"></i>
            Chiffre d'affaires mensuel — 6 derniers mois
        </div>
        <div class="card-body">
            <div class="d-flex align-items-end gap-2" style="height:170px">
                @foreach (var m in _caMensuel)
                {
                    var heightPct = _caMensuelMax > 0 ? Math.Max(3, m.Montant / _caMensuelMax * 100) : 3;
                    <div class="d-flex flex-column align-items-center flex-fill h-100 justify-content-end">
                        <div class="small text-muted mb-1">@m.Montant.ToString("0")</div>
                        <div class="w-75 rounded-top" style="height:@(heightPct.ToString("0.##", CultureInfo.InvariantCulture))%;background:linear-gradient(180deg,#4f46e5,#7c3aed);min-height:3px"></div>
                        <div class="small text-muted mt-2 text-capitalize">@m.Label</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Stock alerts -->
    @if (_alerteStock.Any())
    {
        <div class="card border-warning mb-4">
            <div class="card-header text-warning fw-semibold">
                <i class="bi bi-exclamation-triangle me-1"></i>
                Alertes Stock — @_alerteStock.Count produit(s) sous le seuil minimal
            </div>
            <div class="card-body p-0">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Code</th><th>Désignation</th>
                            <th class="text-end">Stock actuel</th>
                            <th class="text-end">Seuil minimal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _alerteStock.Take(10))
                        {
                            <tr>
                                <td><code>@p.CodeProduit</code></td>
                                <td>@p.DesignationProduit</td>
                                <td class="text-end text-danger fw-bold">@p.Quantite.ToString("0.###")</td>
                                <td class="text-end text-muted">@p.StockMinimal.ToString("0.###")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ── Actions Rapides ────────────────────── -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-lightning-charge-fill text-warning fs-5"></i>
                <span class="fw-semibold fs-6">Actions Rapides</span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="clients/nouveau" class="btn btn-primary btn-action-quick">
                    <i class="bi bi-person-plus me-2"></i>Nouveau Client
                </a>
                <a href="factures-client/nouveau" class="btn btn-success btn-action-quick">
                    <i class="bi bi-receipt me-2"></i>Nouvelle Facture
                </a>
                <a href="devis/nouveau" class="btn btn-action-quick" style="background:#7c3aed;color:#fff;border-color:#7c3aed">
                    <i class="bi bi-file-earmark-text me-2"></i>Nouveau Devis
                </a>
                <a href="produits/nouveau" class="btn btn-warning btn-action-quick">
                    <i class="bi bi-box-seam me-2"></i>Nouveau Produit
                </a>
            </div>
        </div>
    </div>

    <!-- ── Activité Récente ───────────────────── -->
    <div class="card border-0 shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-clock-history me-1 text-primary"></i>
                Activité Récente
            </span>
            <a href="factures-client" class="btn btn-sm btn-outline-secondary">Tout voir</a>
        </div>
        <div class="card-body p-0">
            @if (_dernieresFactures.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var f in _dernieresFactures)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="activity-icon-wrap" style="background:#e8f0fe">
                                <i class="bi bi-receipt" style="color:#1a73e8"></i>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold small">
                                    Facture
                                    <a href="factures-client/@f.NumeroFactureClient">@f.NumeroFactureClient</a>
                                    —
                                    @f.Client?.NomClient
                                </div>
                                <div class="text-muted" style="font-size:0.78rem">
                                    Montant TTC : <strong>@f.MontantTTC.ToString("0.###") TND</strong>
                                    &nbsp;·&nbsp;
                                    <span class="badge @GetEtatBadge(f.EtatReglement)">@f.EtatReglement</span>
                                </div>
                            </div>
                            <span class="text-muted" style="font-size:0.75rem;white-space:nowrap">
                                @f.DateFactureClient.ToString("dd/MM/yyyy")
                            </span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                    Aucune activité récente.
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly CultureInfo _frCulture = CultureInfo.GetCultureInfo("fr-FR");

    private bool _loading = true;
    private int _nbClients, _nbProduits, _nbFournisseurs, _nbFacturesOuvertes;
    private double _montantNonRegle;
    private double _caDuMois;
    private double _caMensuelMax;
    private List<FactureClient> _dernieresFactures = [];
    private List<Produit> _alerteStock = [];
    private List<(string Label, double Montant)> _caMensuel = [];

    protected override async Task OnInitializedAsync()
    {
        var clients      = await ClientService.GetAllAsync();
        var produits     = await ProduitService.GetAllAsync();
        var fournisseurs = await FournisseurService.GetAllAsync();
        var factures     = await FactureService.GetAllAsync();
        var avoirs       = await FactureService.GetAllAsync(avoirsOnly: true);

        _nbClients          = clients.Count;
        _nbProduits         = produits.Count;
        _nbFournisseurs     = fournisseurs.Count;
        _nbFacturesOuvertes = factures.Count(f => f.EtatReglement != "Réglé");
        _montantNonRegle    = factures
            .Where(f => f.EtatReglement != "Réglé")
            .Sum(f => f.MontantTTC + f.Timbre - f.Reglements.Sum(r => r.Montant));
        _dernieresFactures  = factures.Take(5).ToList();
        _alerteStock        = await ProduitService.GetStockAlerteAsync();

        var today = DateTime.Today;
        _caDuMois = ChiffreAffairesDuMois(factures, avoirs, today.Year, today.Month);

        _caMensuel = Enumerable.Range(0, 6)
            .Select(i => today.AddMonths(-(5 - i)))
            .Select(mois => (
                Label: mois.ToString("MMM yy", _frCulture),
                Montant: ChiffreAffairesDuMois(factures, avoirs, mois.Year, mois.Month)))
            .ToList();
        _caMensuelMax = _caMensuel.Count > 0 ? _caMensuel.Max(m => m.Montant) : 0;

        _loading = false;
    }

    private static double ChiffreAffairesDuMois(List<FactureClient> factures, List<FactureClient> avoirs, int year, int month)
    {
        var ventes = factures.Where(f => f.DateFactureClient.Year == year && f.DateFactureClient.Month == month).Sum(f => f.MontantTTC);
        var retours = avoirs.Where(a => a.DateFactureClient.Year == year && a.DateFactureClient.Month == month).Sum(a => a.MontantTTC);
        return ventes - retours;
    }

    private static string GetEtatBadge(string etat) => etat switch
    {
        "Réglé"               => "bg-success",
        "Partiellement Réglé" => "bg-warning text-dark",
        _                     => "bg-danger"
    };
}
