@page "/admin/utilisateurs"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@inject IUtilisateurService UtilisateurService

<PageTitle>Gestion Utilisateurs – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-people me-2"></i>Utilisateurs</h3>
    <a href="/admin/utilisateurs/nouveau" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouvel Utilisateur
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Login</th>
                        <th>Nom Complet</th>
                        <th>Email</th>
                        <th>Rôle</th>
                        <th>État</th>
                        <th>Créé le</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _utilisateurs)
                    {
                        <tr>
                            <td><code>@u.Login</code></td>
                            <td>@u.NomComplet</td>
                            <td>@u.Email</td>
                            <td>
                                <span class="badge @(u.Role switch { "Admin" => "bg-danger", "Manager" => "bg-warning text-dark", _ => "bg-secondary" })">@u.Role</span>
                            </td>
                            <td>
                                <span class="badge @(u.Actif ? "bg-success" : "bg-warning text-dark")">
                                    @(u.Actif ? "Actif" : "Inactif")
                                </span>
                            </td>
                            <td>@u.DateCreation.ToString("dd/MM/yyyy")</td>
                            <td class="text-end">
                                <a href="/admin/utilisateurs/@u.Id" class="btn btn-sm btn-outline-primary me-1">
                                    <i class="bi bi-pencil me-1"></i>Modifier
                                </a>
                                @if (u.Actif)
                                {
                                    <button class="btn btn-sm btn-outline-warning"
                                            @onclick="() => ToggleActif(u, false)">
                                        <i class="bi bi-pause-circle me-1"></i>Désactiver
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success"
                                            @onclick="() => ToggleActif(u, true)">
                                        <i class="bi bi-play-circle me-1"></i>Activer
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (!_utilisateurs.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Aucun utilisateur.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@_utilisateurs.Count utilisateur(s)</div>
</div>

@code {
    private List<Utilisateur> _utilisateurs = [];
    private bool _loading = true;
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _utilisateurs = await UtilisateurService.GetAllAsync();
        _loading = false;
    }

    private async Task ToggleActif(Utilisateur u, bool actif)
    {
        try
        {
            if (actif)
                await UtilisateurService.ActiverAsync(u.Id);
            else
                await UtilisateurService.DesactiverAsync(u.Id);

            _notif.ShowSuccess($"Utilisateur {u.Login} {(actif ? "activé" : "désactivé")}.");
            _utilisateurs = await UtilisateurService.GetAllAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }
}
