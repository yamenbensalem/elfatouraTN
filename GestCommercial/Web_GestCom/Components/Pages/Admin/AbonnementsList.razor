@page "/admin/demandes-abonnement"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "SuperAdmin")]
@inject IAbonnementService AbonnementService
@inject IAbonnementActivationService ActivationService
@inject ICompanyService CompanyService
@inject Microsoft.Extensions.Options.IOptions<TarifsOptions> TarifsConfig

<PageTitle>Abonnements et licences – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-credit-card me-2"></i>Abonnements et licences</h3>
</div>

<div class="alert alert-info small">
    <i class="bi bi-info-circle me-1"></i>
    Aucun paiement en ligne et aucun email de rappel envoyé tout seul : c'est vous qui activez, relancez et
    renouvelez. En revanche <strong>l'accès se coupe automatiquement</strong> : @AccesEntreprise.JoursGrace jours après
    l'échéance d'un abonnement, et dès la fin d'un essai gratuit. Pour le rétablir après règlement, ouvrez
    « Traiter » et repoussez la date d'échéance. Un client actif sans date d'échéance n'est jamais bloqué, et
    les licences Desktop ne sont pas concernées.
</div>

<Notification @ref="_notif" />

@if (!_loading)
{
    <div class="d-flex flex-wrap gap-2 mb-3" role="group" aria-label="Filtrer les clients">
        @foreach (var filtre in Filtres)
        {
            var nombre = _items.Count(filtre.Critere);
            <button type="button" @key="filtre.Libelle"
                    class="btn btn-sm @(_filtre == filtre.Libelle ? filtre.ClasseActive : "btn-outline-secondary")"
                    aria-pressed="@(_filtre == filtre.Libelle ? "true" : "false")"
                    @onclick="() => _filtre = filtre.Libelle">
                @filtre.Libelle <span class="badge @(_filtre == filtre.Libelle ? "bg-light text-dark" : "bg-secondary") ms-1">@nombre</span>
            </button>
        }
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Client</th>
                        <th>Offre</th>
                        <th>Statut</th>
                        <th>Début</th>
                        <th>Échéance</th>
                        <th>Suivi</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Visibles)
                    {
                        var suivi = Suivi(a);
                        <tr @key="a.Id" class="@(suivi.Etat == EtatSuivi.Suspendu ? "table-danger" : null)">
                            <td>
                                <div class="fw-semibold">@a.NomEntreprise</div>
                                <div class="small text-muted">@a.NomContact · @a.EmailContact@(string.IsNullOrWhiteSpace(a.TelephoneContact) ? "" : $" · {a.TelephoneContact}")</div>
                                <div class="small text-muted">Demande du @a.DateDemande.ToLocalTime().ToString("dd/MM/yyyy")</div>
                            </td>
                            <td>
                                <span class="badge bg-secondary">@TarifsOptions.NomPlan(a.Plan)</span>
                                <div class="small text-muted">@DecrireTarif(a)</div>
                            </td>
                            <td><span class="badge @GetStatutBadge(a.Statut)">@GetStatutLabel(a.Statut)</span></td>
                            <td class="text-nowrap">@(a.DateDebut?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="text-nowrap">@(a.DateEcheance?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>
                                <span class="badge @ClasseSuivi(suivi.Etat)">@LibelleSuivi(a, suivi)</span>
                                @if (a.DateDerniereRelance is DateTime relance)
                                {
                                    <div class="small text-muted">Relancé le @relance.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (suivi.Etat is EtatSuivi.ARelancer or EtatSuivi.Expire or EtatSuivi.Suspendu)
                                {
                                    <button class="btn btn-sm btn-warning me-1" disabled="@(_relanceEnCours == a.Id)" @onclick="() => RelancerAsync(a)">
                                        <i class="bi bi-envelope me-1"></i>@(a.DateDerniereRelance.HasValue ? "Relancer encore" : "Relancer")
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => AskProcess(a)">
                                    <i class="bi bi-pencil me-1"></i>Traiter
                                </button>
                            </td>
                        </tr>
                    }
                    @if (!Visibles.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">@(_items.Count == 0 ? "Aucune demande pour l'instant." : "Aucun client dans ce filtre.")</td></tr>
                    }
                </tbody>
            </table>
            </div>
        }
    </div>
    <div class="card-footer text-muted small">
        @Visibles.Count sur @_items.Count ·
        « À relancer » : échéance dans 30 jours ou moins (7 jours pour un essai ou un abonnement mensuel).
        Accès suspendu @AccesEntreprise.JoursGrace jours après l'échéance (aussitôt pour un essai).
    </div>
</div>

@if (_editVisible && _editing is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,0.5)" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <EditForm Model="_editing" OnValidSubmit="SaveAsync">
                    <div class="modal-header">
                        <h5 class="modal-title">Traiter la demande — @_editing.NomEntreprise</h5>
                        <button type="button" class="btn-close" @onclick="() => _editVisible = false"></button>
                    </div>
                    <div class="modal-body">
                        <Notification @ref="_modalNotif" />
                        <div class="row g-3 mb-3 small text-muted">
                            <div class="col-md-6">
                                <strong>Contact :</strong> @_editing.NomContact — @_editing.EmailContact
                                @(string.IsNullOrWhiteSpace(_editing.TelephoneContact) ? "" : $" — {_editing.TelephoneContact}")
                            </div>
                            <div class="col-md-6"><strong>Plan demandé :</strong> @TarifsOptions.NomPlan(_editing.Plan) — @DecrireTarif(_editing)@(_editing.CodePromo is null ? "" : $" (code {_editing.CodePromo}, catalogue {_editing.PrixCatalogue:0.##} DT)")</div>
                            @if (!string.IsNullOrWhiteSpace(_editing.Message))
                            {
                                <div class="col-12"><strong>Message :</strong> @_editing.Message</div>
                            }
                        </div>
                        <hr />
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Statut</label>
                                <InputSelect class="form-select" @bind-Value="_editing.Statut" @bind-Value:after="RefreshCompteAsync">
                                    <option value="EnAttente">En attente</option>
                                    <option value="Contactee">Contactée</option>
                                    <option value="Essai">Essai (@JoursEssai jours)</option>
                                    <option value="Active">Active</option>
                                    <option value="Refusee">Refusée</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Entreprise liée</label>
                                <InputSelect class="form-select" @bind-Value="_editing.CompanyId" @bind-Value:after="RefreshCompteAsync">
                                    <option value="">— Aucune —</option>
                                    @foreach (var c in _companies)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                </InputSelect>
                                <div class="form-text">Laissez « Aucune » pour qu'elle soit créée automatiquement à l'activation (Essai ou Active).</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date de début</label>
                                <InputDate class="form-control" @bind-Value="_editing.DateDebut" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date d'échéance</label>
                                <InputDate class="form-control" @bind-Value="_editing.DateEcheance" />
                            </div>
                            @if (EstActif)
                            {
                                <div class="col-12 form-text mt-1">
                                    @if (_datesProposees)
                                    {
                                        <span>Dates proposées d'après l'offre : vérifiez-les avant d'enregistrer. </span>
                                    }
                                    Ces dates servent au suivi : sans échéance, ce client ne remontera jamais « à relancer ».
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-1" @onclick="ProposerDates">
                                        Recalculer à partir d'aujourd'hui
                                    </button>
                                </div>
                            }
                            <div class="col-12">
                                <label class="form-label">Notes internes</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="_editing.NotesAdmin" />
                            </div>
                            @if (TarifsOptions.EstAchatUnique(_editing.Plan))
                            {
                                <div class="col-12">
                                    <div class="alert alert-secondary small mb-0">
                                        <i class="bi bi-pc-display me-1"></i>
                                        <strong>Licence @TarifsOptions.NomPlan(_editing.Plan).</strong> Aucune entreprise ni compte web
                                        n'est créé, et aucun email automatique n'est envoyé : installez le logiciel chez le client,
                                        générez son fichier de licence, puis renseignez la date de début (elle fait courir la
                                        garantie et la maintenance incluse) et la date d'échéance de la maintenance.
                                    </div>
                                </div>
                            }
                            else if (EstActif)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-3 bg-light">
                                        <div class="fw-semibold mb-2"><i class="bi bi-person-check me-1"></i>Accès du client</div>
                                        @if (!_editing.CompanyId.HasValue)
                                        {
                                            <div class="small mb-2">
                                                <i class="bi bi-building-add me-1"></i>L'entreprise « @_editing.NomEntreprise » (plan @_editing.Plan) sera créée à l'enregistrement.
                                            </div>
                                        }
                                        @if (_compteRequis)
                                        {
                                            <div class="small text-muted mb-2">
                                                Aucun compte n'existe encore pour cette entreprise : un compte Admin sera créé avec ces identifiants.
                                            </div>
                                            <div class="row g-2">
                                                <div class="col-md-6">
                                                    <label class="form-label small mb-1" for="acces-login">Login</label>
                                                    <input id="acces-login" class="form-control" @bind="_accesLogin" autocomplete="off" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label small mb-1" for="acces-mdp">Mot de passe</label>
                                                    <div class="input-group">
                                                        <input id="acces-mdp" class="form-control font-monospace" @bind="_accesMotDePasse" autocomplete="off" />
                                                        <button type="button" class="btn btn-outline-secondary" title="Générer un autre mot de passe"
                                                                @onclick="() => _accesMotDePasse = ActivationService.GenererMotDePasse()">
                                                            <i class="bi bi-arrow-repeat"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-text">Le mot de passe n'est affiché qu'ici et dans l'email au client — il n'est pas conservé en clair.</div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">Cette entreprise a déjà un compte : aucun identifiant ne sera créé ni modifié.</div>
                                        }
                                        <div class="form-check mt-2">
                                            <input type="checkbox" class="form-check-input" id="envoyer-email" @bind="_envoyerEmail" />
                                            <label class="form-check-label small" for="envoyer-email">
                                                Envoyer un email de confirmation à @_editing.EmailContact@(_compteRequis ? " (avec les identifiants)" : "")
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => _editVisible = false">Annuler</button>
                        <button type="submit" class="btn btn-primary">Enregistrer</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Abonnement> _items = [];
    private List<Company> _companies = [];
    private bool _loading = true;
    private bool _editVisible;
    private Abonnement? _editing;
    private Notification _notif = default!;
    private Notification? _modalNotif;

    // Bloc « Accès du client » de la fenêtre de traitement
    private bool _compteRequis;
    private string _accesLogin = "";
    private string _accesMotDePasse = "";
    private bool _envoyerEmail = true;
    private bool EstActif => _editing is not null && AbonnementActivationService.EstActif(_editing.Statut);
    private bool _datesProposees;

    // ── Suivi des échéances ──
    private sealed record Filtre(string Libelle, string ClasseActive, Func<Abonnement, bool> Critere);

    private string _filtre = "Tous";
    private int? _relanceEnCours;

    private static SuiviAbonnement Suivi(Abonnement a) => SuiviAbonnement.Evaluer(a, DateTime.Today);

    private static readonly Filtre[] Filtres =
    [
        new("Tous", "btn-secondary", _ => true),
        new("À relancer", "btn-warning", a => Suivi(a).Etat == EtatSuivi.ARelancer),
        new("Accès suspendu", "btn-danger", a => Suivi(a).Etat == EtatSuivi.Suspendu),
        new("Échéance dépassée", "btn-danger", a => Suivi(a).Etat == EtatSuivi.Expire),
        new("Dates à renseigner", "btn-dark", a => Suivi(a).Etat == EtatSuivi.DatesManquantes),
        new("En cours", "btn-success", a => Suivi(a).Etat == EtatSuivi.EnCours),
        new("Demandes à traiter", "btn-primary", a => a.Statut is "EnAttente" or "Contactee")
    ];

    // Ce qui demande une action remonte en tête : expirés, à relancer, dates manquantes, demandes
    // en attente ; puis les clients en cours, par échéance la plus proche.
    private List<Abonnement> Visibles => _items
        .Where(Filtres.Single(f => f.Libelle == _filtre).Critere)
        .OrderBy(a => Suivi(a).Etat switch
        {
            EtatSuivi.Suspendu => -1,
            EtatSuivi.Expire => 0,
            EtatSuivi.ARelancer => 1,
            EtatSuivi.DatesManquantes => 2,
            EtatSuivi.EnCours => 4,
            _ => a.Statut is "EnAttente" or "Contactee" ? 3 : 5
        })
        .ThenBy(a => a.DateEcheance ?? DateTime.MaxValue)
        .ThenByDescending(a => a.DateDemande)
        .ToList();

    private static string ClasseSuivi(EtatSuivi etat) => etat switch
    {
        EtatSuivi.Suspendu => "bg-danger",
        EtatSuivi.Expire => "bg-danger-subtle text-danger-emphasis border border-danger-subtle",
        EtatSuivi.ARelancer => "bg-warning text-dark",
        EtatSuivi.DatesManquantes => "bg-dark",
        EtatSuivi.EnCours => "bg-success",
        _ => "bg-light text-muted border"
    };

    private static string Jours(int n) => n == 1 ? "1 jour" : $"{n} jours";

    private static string LibelleSuivi(Abonnement a, SuiviAbonnement suivi) => suivi.Etat switch
    {
        EtatSuivi.Suspendu => $"Accès suspendu depuis {Jours(-suivi.JoursRestants!.Value - AccesEntreprise.JoursGracePour(a))}",
        // Licence Desktop : la maintenance est finie, rien n'est coupé.
        EtatSuivi.Expire when TarifsOptions.EstAchatUnique(a.Plan) => $"Maintenance terminée depuis {Jours(-suivi.JoursRestants!.Value)}",
        EtatSuivi.Expire => AccesEntreprise.JoursGracePour(a) + suivi.JoursRestants!.Value is var reste and > 0
            ? $"Échéance dépassée : suspension dans {Jours(reste)}"
            : "Échéance dépassée : suspension demain",
        EtatSuivi.ARelancer => suivi.JoursRestants switch
        {
            0 => "À relancer : se termine aujourd'hui",
            1 => "À relancer : 1 jour restant",
            _ => $"À relancer : {suivi.JoursRestants} jours restants"
        },
        EtatSuivi.DatesManquantes => "Dates à renseigner",
        EtatSuivi.EnCours => $"En cours : {suivi.JoursRestants} jours restants",
        _ => "—"
    };

    private async Task RelancerAsync(Abonnement a)
    {
        _relanceEnCours = a.Id;
        try
        {
            if (await AbonnementService.RelancerAsync(a.Id))
            {
                await LoadAsync();
                _notif.ShowSuccess($"Email de relance envoyé à {a.EmailContact}.");
            }
            else
            {
                _notif.ShowError($"L'email de relance n'a pas pu être envoyé à {a.EmailContact} : le service d'envoi l'a refusé ou n'est pas configuré. Le détail est dans les logs.");
            }
        }
        catch (Exception ex) { _notif.ShowError(ex); }
        finally { _relanceEnCours = null; }
    }

    private void ProposerDates()
    {
        (var debut, var echeance) = SuiviAbonnement.DatesProposees(_editing!, TarifsConfig.Value, DateTime.Today);
        _editing!.DateDebut = debut;
        _editing.DateEcheance = echeance;
        _datesProposees = true;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _items = await AbonnementService.GetAllAsync();
        _companies = await CompanyService.GetAllAsync();
        _loading = false;
    }

    private async Task AskProcess(Abonnement a)
    {
        _editing = new Abonnement
        {
            Id = a.Id,
            NomEntreprise = a.NomEntreprise,
            NomContact = a.NomContact,
            EmailContact = a.EmailContact,
            TelephoneContact = a.TelephoneContact,
            Plan = a.Plan,
            CycleFacturation = a.CycleFacturation,
            CodePromo = a.CodePromo,
            PrixCatalogue = a.PrixCatalogue,
            PrixApplique = a.PrixApplique,
            ModePaiementSouhaite = a.ModePaiementSouhaite,
            Message = a.Message,
            Statut = a.Statut,
            DateDemande = a.DateDemande,
            DateDebut = a.DateDebut,
            DateEcheance = a.DateEcheance,
            DateDerniereRelance = a.DateDerniereRelance,
            NotesAdmin = a.NotesAdmin,
            CompanyId = a.CompanyId
        };
        _accesLogin = await ActivationService.SuggererLoginAsync(a.NomContact);
        _accesMotDePasse = ActivationService.GenererMotDePasse();
        _envoyerEmail = true;
        _datesProposees = false;
        await RefreshCompteAsync();
        _editVisible = true;
    }

    private async Task RefreshCompteAsync()
    {
        _compteRequis = _editing is not null && await ActivationService.CompteRequisAsync(_editing);

        // Activation sans dates : on les propose d'après l'offre plutôt que de laisser le client hors suivi.
        if (EstActif && _editing!.DateDebut is null && _editing.DateEcheance is null)
            ProposerDates();
    }

    private async Task SaveAsync()
    {
        try
        {
            var acces = _compteRequis ? new AccesCompte(_accesLogin, _accesMotDePasse) : null;
            var resultat = await ActivationService.EnregistrerAsync(_editing!, acces, _envoyerEmail);

            var message = "Demande mise à jour.";
            if (resultat.EntrepriseCreee) message += " Entreprise créée.";
            if (resultat.LoginCree is not null) message += $" Compte client créé (login : {resultat.LoginCree}).";
            if (resultat.EmailDemande) message += $" Email de confirmation envoyé à {_editing!.EmailContact}.";
            _editVisible = false;
            await LoadAsync();
            _notif.ShowSuccess(message);
        }
        catch (Exception ex) { (_modalNotif ?? _notif).ShowError(ex); }
    }

    private static string GetStatutBadge(string statut) => statut switch
    {
        "Active"    => "bg-success",
        "Essai"     => "bg-primary",
        "Contactee" => "bg-info text-dark",
        "Refusee"   => "bg-danger",
        _           => "bg-warning text-dark"
    };

    private int JoursEssai => TarifsConfig.Value.JoursEssai;

    private static string DecrireTarif(Abonnement a) => a.PrixApplique is double prix
        ? TarifsOptions.EstAchatUnique(a.Plan)
            ? $"{prix:0.##} DT HT, paiement unique"
            : $"{prix:0.##} DT HT / {(a.CycleFacturation == CycleFacturation.Mensuel ? "mois" : "an")}"
        : a.Plan == "Enterprise" ? "Sur devis" : "Prix non enregistré"; // demandes antérieures aux prix figés

    private string GetStatutLabel(string statut) => statut switch
    {
        "Active"    => "Active",
        "Essai"     => $"Essai ({JoursEssai} jours)",
        "Contactee" => "Contactée",
        "Refusee"   => "Refusée",
        _           => "En attente"
    };
}
