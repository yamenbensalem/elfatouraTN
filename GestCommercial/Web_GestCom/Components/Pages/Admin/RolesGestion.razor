@page "/admin/roles"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using Microsoft.EntityFrameworkCore
@using Web_GestCom.Data
@using Web_GestCom.Data.Models
@using Web_GestCom.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject IPermissionService PermissionService
@inject ITenantService TenantService

<PageTitle>Gestion des Rôles – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="bi bi-shield-lock me-2"></i>Rôles &amp; Permissions</h3>
</div>

<Notification @ref="_notif" />

@if (_loading)
{
    <LoadingSpinner Loading="true" />
}
else
{
    <div class="row g-3">
        @* ── Role selector ── *@
        <div class="col-md-3">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light fw-semibold">Rôles</div>
                <div class="list-group list-group-flush">
                    @foreach (var role in _roles)
                    {
                        <button class="list-group-item list-group-item-action @(_selectedRole?.Id == role.Id ? "active" : "")"
                                @onclick="() => SelectRole(role)">
                            <i class="bi bi-person-badge me-2"></i>@role.Name
                            @if (role.CompanyId is null)
                            {
                                <span class="badge bg-secondary ms-1">Système</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>

        @* ── Permission matrix ── *@
        <div class="col-md-9">
            @if (_selectedRole is null)
            {
                <div class="text-muted mt-3">Sélectionnez un rôle pour voir ses permissions.</div>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">Permissions — @_selectedRole.Name</span>
                        <button class="btn btn-sm btn-primary" @onclick="SaveAsync">
                            <i class="bi bi-floppy me-1"></i>Enregistrer
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered table-sm mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Module</th>
                                    <th class="text-center">Voir</th>
                                    <th class="text-center">Créer</th>
                                    <th class="text-center">Modifier</th>
                                    <th class="text-center">Supprimer</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var module in _modules)
                                {
                                    <tr>
                                        <td class="fw-semibold">@ModuleLabel(module)</td>
                                        @foreach (var action in _actions)
                                        {
                                            var perm = _permissions.FirstOrDefault(p => p.Feature == module && p.Action == action);
                                            if (perm is null) { <td></td> continue; }
                                            var permId = perm.Id;
                                            <td class="text-center">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       checked="@_granted.Contains(permId)"
                                                       @onchange="e => Toggle(permId, (bool)e.Value!)" />
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private Notification? _notif;
    private bool _loading = true;

    private List<AppRole>     _roles       = [];
    private List<Permission>  _permissions = [];
    private AppRole?          _selectedRole;
    private HashSet<int>      _granted     = [];

    private static readonly string[] _modules = [
        "clients",
        "factures",
        "devis",
        "commandes-vente",
        "bons-livraison",
        "fournisseurs",
        "commandes-achat",
        "bons-reception",
        "factures-fournisseur",
        "produits"
    ];
    private static readonly string[] _actions = ["view", "create", "update", "delete"];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _roles       = await db.AppRoles.OrderBy(r => r.Id).ToListAsync();
        _permissions = await db.Permissions.ToListAsync();
        _loading = false;
    }

    private async Task SelectRole(AppRole role)
    {
        _selectedRole = role;
        await using var db = await DbFactory.CreateDbContextAsync();
        var ids = await db.RolePermissions
            .Where(rp => rp.RoleId == role.Id)
            .Select(rp => rp.PermissionId)
            .ToListAsync();
        _granted = [.. ids];
    }

    private void Toggle(int permId, bool value)
    {
        if (value) _granted.Add(permId);
        else        _granted.Remove(permId);
    }

    private async Task SaveAsync()
    {
        if (_selectedRole is null) return;

        var currentCompanyId = TenantService.CurrentCompanyId;
        if (currentCompanyId.HasValue && _selectedRole.CompanyId != currentCompanyId)
        {
            _notif?.ShowError("Vous ne pouvez modifier que les rôles de votre entreprise.");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var existing = await db.RolePermissions
            .Where(rp => rp.RoleId == _selectedRole.Id)
            .ToListAsync();
        db.RolePermissions.RemoveRange(existing);

        foreach (var permId in _granted)
            db.RolePermissions.Add(new RolePermission { RoleId = _selectedRole.Id, PermissionId = permId });

        await db.SaveChangesAsync();

        var affectedUsers = await db.UserRoles
            .Where(ur => ur.RoleId == _selectedRole.Id)
            .Select(ur => ur.UserId)
            .Distinct()
            .ToListAsync();
        foreach (var uid in affectedUsers)
            PermissionService.InvalidateUser(uid);

        _notif?.ShowSuccess("Permissions enregistrées.");
    }

    private static string ModuleLabel(string module) => module switch
    {
        "clients"               => "Clients",
        "factures"              => "Factures clients",
        "devis"                 => "Devis",
        "commandes-vente"       => "Commandes vente",
        "bons-livraison"        => "Bons de livraison",
        "fournisseurs"          => "Fournisseurs",
        "commandes-achat"       => "Commandes achat",
        "bons-reception"        => "Bons de réception",
        "factures-fournisseur"  => "Factures fournisseur",
        "produits"              => "Produits",
        _                       => module
    };
}
