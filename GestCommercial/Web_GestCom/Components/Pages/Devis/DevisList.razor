@page "/devis"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:devis.view")]
@inject IDevisClientService DevisService
@inject NavigationManager Nav

<PageTitle>Devis – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Devis</h3>
    <a href="devis/nouveau" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau Devis
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label small mb-1">Client</label>
            <select class="form-select form-select-sm" style="min-width:160px" @bind="_filterClient">
                <option value="">Tous</option>
                @foreach (var c in ClientsDistincts)
                { <option value="@c.CodeClient">@c.NomClient</option> }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">État</label>
            <select class="form-select form-select-sm" style="min-width:140px" @bind="_filterEtat">
                <option value="">Tous</option>
                <option value="Ouvert">Ouvert</option>
                <option value="Confirmé">Confirmé</option>
                <option value="Annulé">Annulé</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Du</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterDebut" />
        </div>
        <div>
            <label class="form-label small mb-1">Au</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterFin" />
        </div>
        <button class="btn btn-sm btn-outline-secondary mb-0" @onclick="ResetFilters">
            <i class="bi bi-x-circle"></i> Réinitialiser
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Devis</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in FilteredDevis)
                    {
                        <tr>
                            <td><a href="devis/@d.NumeroDevis">@d.NumeroDevis</a></td>
                            <td>@d.DateDevis.ToString("dd/MM/yyyy")</td>
                            <td>@d.Client?.NomClient</td>
                            <td class="text-end">@d.MontantHT.ToString("0.###")</td>
                            <td class="text-end">@d.MontantTVA.ToString("0.###")</td>
                            <td class="text-end fw-bold">@d.MontantTTC.ToString("0.###")</td>
                            <td><span class="badge bg-secondary">@d.EtatDevis</span></td>
                            <td class="text-end">
                                <PermissionGuard Permission="devis.update">
                                    <a href="devis/@d.NumeroDevis" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil me-1"></i>Modifier
                                    </a>
                                </PermissionGuard>
                                <button class="btn btn-sm btn-outline-info me-1" @onclick="() => CloneDevis(d.NumeroDevis)">
                                    <i class="bi bi-copy me-1"></i>Cloner
                                </button>
                                <PermissionGuard Permission="devis.delete">
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(d)">
                                        <i class="bi bi-trash me-1"></i>Supprimer
                                    </button>
                                </PermissionGuard>
                            </td>
                        </tr>
                    }
                    @if (!FilteredDevis.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">Aucun devis trouvé.</td></tr>
                    }
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@FilteredDevis.Count() / @_devis.Count devis</div>
</div>

<ConfirmDialog Title="Supprimer le devis"
               Message="@($"Confirmer la suppression du devis {_toDelete?.NumeroDevis} ?")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<DevisClient> _devis = [];
    private bool _loading = true;
    private bool _confirmVisible;
    private DevisClient? _toDelete;
    private Notification _notif = default!;

    private string? _filterClient;
    private string? _filterEtat;
    private DateTime? _filterDebut;
    private DateTime? _filterFin;

    private IEnumerable<DevisClient> FilteredDevis => _devis.Where(d =>
        (string.IsNullOrEmpty(_filterClient) || d.CodeClient == _filterClient) &&
        (string.IsNullOrEmpty(_filterEtat) || d.EtatDevis == _filterEtat) &&
        (!_filterDebut.HasValue || d.DateDevis.Date >= _filterDebut.Value.Date) &&
        (!_filterFin.HasValue || d.DateDevis.Date <= _filterFin.Value.Date));

    private List<Client> ClientsDistincts => _devis
        .Where(d => d.Client is not null)
        .Select(d => d.Client!)
        .DistinctBy(c => c.CodeClient)
        .OrderBy(c => c.NomClient)
        .ToList();

    private void ResetFilters()
    {
        _filterClient = null;
        _filterEtat = null;
        _filterDebut = null;
        _filterFin = null;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _devis = await DevisService.GetAllAsync();
        _loading = false;
    }

    private async Task CloneDevis(string numero)
    {
        try
        {
            var clone = await DevisService.CloneAsync(numero);
            _notif.ShowSuccess($"Devis cloné : {clone.NumeroDevis}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur lors du clonage : {ex.Message}");
        }
    }

    private void AskDelete(DevisClient d) { _toDelete = d; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        try
        {
            await DevisService.DeleteAsync(_toDelete.NumeroDevis);
            _notif.ShowSuccess("Devis supprimé.");
            _toDelete = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }
}
