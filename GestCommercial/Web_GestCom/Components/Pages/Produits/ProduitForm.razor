@page "/produits/nouveau"
@page "/produits/{Code}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:produits.view")]
@inject IProduitService ProduitService
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "Nouveau Produit" : "Modifier Produit") – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>@(_isNew ? "Nouveau Produit" : _produit.DesignationProduit)</h3>
    <a href="produits" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
</div>

<Notification @ref="_notif" />
<LoadingSpinner Loading="@_loading" />

@if (!_loading)
{
    <EditForm Model="_produit" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Identification</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Code Produit</label>
                        <InputText class="form-control" @bind-Value="_produit.CodeProduit" disabled="@(!_isNew)" placeholder="Auto-généré" />
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">Désignation <span class="text-danger">*</span></label>
                        <InputText class="form-control" @bind-Value="_produit.DesignationProduit" />
                        <ValidationMessage For="() => _produit.DesignationProduit" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Catégorie</label>
                        <InputSelect class="form-select" @bind-Value="_produit.CodeCategorieProduit">
                            @foreach (var c in _categories)
                            { <option value="@c.CodeCategorieProduit">@c.NomCategorieProduit</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Unité</label>
                        <InputSelect class="form-select" @bind-Value="_produit.CodeUniteProduit">
                            @foreach (var u in _unites)
                            { <option value="@u.CodeUniteProduit">@u.NomUniteProduit</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Fabricant</label>
                        <InputSelect class="form-select" @bind-Value="_produit.CodeFabriquantProduit">
                            @foreach (var f in _fabriquants)
                            { <option value="@f.CodeFabriquantProduit">@f.NomFabriquantProduit</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Devise</label>
                        <InputSelect class="form-select" @bind-Value="_produit.CodeDevise">
                            @foreach (var d in _devises)
                            { <option value="@d.CodeDevise">@d.NomDevise</option> }
                        </InputSelect>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Tarification</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Prix Achat TTC</label>
                        <InputNumber class="form-control" @bind-Value="_produit.PrixAchatTTC" @bind-Value:after="RecalculatePrix" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Taux Marge (%)</label>
                        <InputNumber class="form-control" @bind-Value="_produit.TauxMarge" @bind-Value:after="RecalculatePrix" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">TVA</label>
                        <InputSelect class="form-select" @bind-Value="_produit.CodeTvaProduit" @bind-Value:after="RecalculatePrix">
                            @foreach (var t in _tvas)
                            { <option value="@t.CodeTvaProduit">@t.NomTvaProduit</option> }
                        </InputSelect>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">FODEC (%)</label>
                        <InputNumber class="form-control" @bind-Value="_produit.Fodec" @bind-Value:after="RecalculatePrix" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Prix Vente HT</label>
                        <InputNumber class="form-control" @bind-Value="_produit.PrixVenteHT" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Prix Vente TTC</label>
                        <InputNumber class="form-control" @bind-Value="_produit.PrixVenteTTC" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Remise (%)</label>
                        <InputNumber class="form-control" @bind-Value="_produit.Remise" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Remise Max (%)</label>
                        <InputNumber class="form-control" @bind-Value="_produit.RemiseMaximale" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header fw-semibold">Stock & Localisation</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label">Quantité</label>
                        <InputNumber class="form-control" @bind-Value="_produit.Quantite" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Stock Minimal</label>
                        <InputNumber class="form-control" @bind-Value="_produit.StockMinimal" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Rayon</label>
                        <InputText class="form-control" @bind-Value="_produit.Rayon" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Étage</label>
                        <InputText class="form-control" @bind-Value="_produit.Etage" />
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <PermissionGuard Permission="@(_isNew ? "produits.create" : "produits.update")">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Enregistrer</button>
            </PermissionGuard>
            <a href="produits" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </EditForm>
}

@code {
    [Parameter] public string? Code { get; set; }

    private Produit _produit = new();
    private List<CategorieProduit> _categories = [];
    private List<UniteProduit> _unites = [];
    private List<TvaProduit> _tvas = [];
    private List<FabriquantProduit> _fabriquants = [];
    private List<Devise> _devises = [];
    private bool _loading = true;
    private bool _isNew => string.IsNullOrEmpty(Code);
    private Notification _notif = default!;

    protected override async Task OnInitializedAsync()
    {
        _categories = await Db.CategoriesProduit.ToListAsync();
        _unites = await Db.UnitesProduit.ToListAsync();
        _tvas = await Db.TvasProduit.ToListAsync();
        _fabriquants = await Db.FabriquantsProduit.ToListAsync();
        _devises = await Db.Devises.ToListAsync();

        if (!_isNew)
        {
            var existing = await ProduitService.GetByCodeAsync(Code!);
            if (existing is not null) _produit = existing;
        }
        _loading = false;
    }

    private void RecalculatePrix()
    {
        var tva = _tvas.FirstOrDefault(t => t.CodeTvaProduit == _produit.CodeTvaProduit)?.TauxTvaProduit ?? 0;
        _produit.PrixVenteHT = Math.Round(_produit.PrixAchatTTC * (1 + _produit.TauxMarge / 100), 3);
        _produit.PrixVenteTTC = Math.Round(_produit.PrixVenteHT * (1 + (_produit.Fodec + tva) / 100), 3);
    }

    private async Task SaveAsync()
    {
        try
        {
            if (_isNew) await ProduitService.AddAsync(_produit);
            else await ProduitService.UpdateAsync(_produit);
            Nav.NavigateTo("produits");
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur : {ex.Message}");
        }
    }
}
