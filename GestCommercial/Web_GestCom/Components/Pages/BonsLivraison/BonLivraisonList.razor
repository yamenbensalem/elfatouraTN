@page "/bons-livraison"
@rendermode InteractiveServer
@attribute [Authorize(Policy = "perm:bons-livraison.view")]
@inject IBonLivraisonService BonService
@inject NavigationManager Nav

<PageTitle>Bons de Livraison – GestCom</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Bons de Livraison</h3>
    <a href="bons-livraison/nouveau" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nouveau Bon
    </a>
</div>

<Notification @ref="_notif" />

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label class="form-label small mb-1">Client</label>
            <select class="form-select form-select-sm" style="min-width:160px" @bind="_filterClient">
                <option value="">Tous</option>
                @foreach (var c in ClientsDistincts)
                { <option value="@c.CodeClient">@c.NomClient</option> }
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">État</label>
            <select class="form-select form-select-sm" style="min-width:140px" @bind="_filterEtat">
                <option value="">Tous</option>
                <option value="Ouvert">Ouvert</option>
                <option value="Livré">Livré</option>
                <option value="Annulé">Annulé</option>
            </select>
        </div>
        <div>
            <label class="form-label small mb-1">Du</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterDebut" />
        </div>
        <div>
            <label class="form-label small mb-1">Au</label>
            <input type="date" class="form-control form-control-sm" @bind="_filterFin" />
        </div>
        <button class="btn btn-sm btn-outline-secondary mb-0" @onclick="ResetFilters">
            <i class="bi bi-x-circle"></i> Réinitialiser
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <LoadingSpinner Loading="@_loading" />
        @if (!_loading)
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° Bon</th>
                        <th>Date</th>
                        <th>Client</th>
                        <th>N° Commande</th>
                        <th class="text-end">Montant HT</th>
                        <th class="text-end">TVA</th>
                        <th class="text-end">Total TTC</th>
                        <th>État</th>
                        <th>Facturation</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <Virtualize Items="FilteredBons" Context="b">
                        <ItemContent>
                            <tr>
                                <td><a href="bons-livraison/@b.NumeroBonLivraison">@b.NumeroBonLivraison</a></td>
                                <td>@b.DateBonLivraison.ToString("dd/MM/yyyy")</td>
                                <td>@b.Client?.NomClient</td>
                                <td>@(b.NumeroCommandeVente ?? "-")</td>
                                <td class="text-end">@b.MontantHT.ToString("0.###")</td>
                                <td class="text-end">@b.MontantTVA.ToString("0.###")</td>
                                <td class="text-end fw-bold">@b.MontantTTC.ToString("0.###")</td>
                                <td><span class="badge bg-secondary">@b.EtatBonLivraison</span></td>
                                <td><span class="badge @GetFactureBadge(b.EtatFacture)">@b.EtatFacture</span></td>
                                <td class="text-end">
                                    <PermissionGuard Permission="bons-livraison.update">
                                        <a href="bons-livraison/@b.NumeroBonLivraison" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil me-1"></i>Modifier
                                        </a>
                                    </PermissionGuard>
                                    <button class="btn btn-sm btn-outline-info me-1" @onclick="() => CloneBon(b.NumeroBonLivraison)">
                                        <i class="bi bi-copy me-1"></i>Cloner
                                    </button>
                                    <PermissionGuard Permission="bons-livraison.delete">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(b)">
                                            <i class="bi bi-trash me-1"></i>Supprimer
                                        </button>
                                    </PermissionGuard>
                                </td>
                            </tr>
                        </ItemContent>
                        <EmptyContent>
                            <tr><td colspan="10" class="text-center text-muted py-4">Aucun bon de livraison trouvé.</td></tr>
                        </EmptyContent>
                    </Virtualize>
                </tbody>
            </table>
        }
    </div>
    <div class="card-footer text-muted small">@FilteredBons.Count / @_bons.Count bon(s) de livraison</div>
</div>

<ConfirmDialog Title="Supprimer le bon de livraison"
               Message="@($"Confirmer la suppression du bon {_toDelete?.NumeroBonLivraison} ? Le stock sera restitué.")"
               Visible="_confirmVisible"
               OnConfirm="DeleteConfirmed"
               OnCancel="() => _confirmVisible = false" />

@code {
    private List<BonLivraison> _bons = [];
    private bool _loading = true;
    private bool _confirmVisible;
    private BonLivraison? _toDelete;
    private Notification _notif = default!;

    private string? _filterClient;
    private string? _filterEtat;
    private DateTime? _filterDebut;
    private DateTime? _filterFin;

    private List<BonLivraison> FilteredBons => _bons.Where(b =>
        (string.IsNullOrEmpty(_filterClient) || b.CodeClient == _filterClient) &&
        (string.IsNullOrEmpty(_filterEtat) || b.EtatBonLivraison == _filterEtat) &&
        (!_filterDebut.HasValue || b.DateBonLivraison.Date >= _filterDebut.Value.Date) &&
        (!_filterFin.HasValue || b.DateBonLivraison.Date <= _filterFin.Value.Date))
        .ToList();

    private List<Client> ClientsDistincts => _bons
        .Where(b => b.Client is not null)
        .Select(b => b.Client!)
        .DistinctBy(c => c.CodeClient)
        .OrderBy(c => c.NomClient)
        .ToList();

    private void ResetFilters()
    {
        _filterClient = null;
        _filterEtat = null;
        _filterDebut = null;
        _filterFin = null;
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _bons = await BonService.GetAllAsync();
        _loading = false;
    }

    private async Task CloneBon(string numero)
    {
        try
        {
            var clone = await BonService.CloneAsync(numero);
            _notif.ShowSuccess($"Bon cloné : {clone.NumeroBonLivraison}");
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _notif.ShowError($"Erreur lors du clonage : {ex.Message}");
        }
    }

    private void AskDelete(BonLivraison b) { _toDelete = b; _confirmVisible = true; }

    private async Task DeleteConfirmed()
    {
        _confirmVisible = false;
        if (_toDelete is null) return;
        await BonService.DeleteAsync(_toDelete.NumeroBonLivraison);
        _notif.ShowSuccess("Bon de livraison supprimé.");
        _toDelete = null;
        await LoadAsync();
    }

    private static string GetFactureBadge(string etat) => etat switch
    {
        "Facturé" => "bg-success",
        "Partiellement Facturé" => "bg-warning text-dark",
        _ => "bg-secondary"
    };
}
