# nginx vhost overrides — gestioncom.tijaraflow.fr
# Blazor Server utilise SignalR (WebSocket) — timeout et upgrade obligatoires.
# La variable de map "connection upgrade" n'est disponible que sur certaines versions
# de nginx-proxy — on n'en dépend pas.
#
# IMPORTANT (bug découvert 2026-09-06, cf. ~/.claude/CLAUDE.md) : réutiliser la variable de
# l'en-tête Upgrade du client pour l'en-tête Connection envoie littéralement sa valeur (ex.
# "websocket") au lieu du mot-clé "upgrade" que Kestrel attend pour reconnaître une requête
# d'upgrade WebSocket. Sans le mot-clé exact, Kestrel répond 200 au lieu de 101 et SignalR
# bascule silencieusement en long-polling — le bug ne se voit pas tant qu'aucune reconnexion
# n'est nécessaire. D'où la chaîne littérale "upgrade" ci-dessous, pas une variable.

# WebSocket upgrade (SignalR)
proxy_http_version 1.1;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection "upgrade";
proxy_buffering off;

# Timeouts longs pour les circuits Blazor Server
proxy_read_timeout  3600s;
proxy_send_timeout  3600s;

# Taille max du body (upload logo, etc.)
client_max_body_size 10m;
