# Build artifacts — regenerated by publish-and-obfuscate.ps1, never committed.
dist/
publish/
obfuscated/
Obfuscar.generated.xml

# The de-obfuscation key. If this ever ends up in git history, the obfuscation is worthless —
# treat it like a secret, not a build artifact.
mapping-archive/

# The RSA private key used to sign client licenses. IRREPLACEABLE — if this is lost, no future
# license can ever be issued that validates against public keys already embedded in apps shipped
# to clients. Never commit it, never email it unencrypted, back it up somewhere outside git.
keys/

# Packaged client handoffs assembled by build-client-package.ps1 — regenerated on demand.
client-package/

# The template database backup (.bak) produced by sql/prepare-template-database.ps1 by literally
# running Web_GestCom's own startup migrations against an empty DB and backing up the result —
# a regeneratable build artifact, not source. A SQL Server .bak is also a binary blob (tens of MB)
# that doesn't belong in git history — re-run prepare-template-database.ps1 whenever the schema
# changes instead of trying to diff/version this file.
db-template/
